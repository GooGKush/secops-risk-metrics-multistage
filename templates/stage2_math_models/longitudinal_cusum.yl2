// Stage 2: Daily Standardized Slack-Excess Drift Extraction — Windowed Slack Sum Prefilter (by 1d)
// Note: YARA-L 2.0 cannot carry recursive S_{t-1} state across time buckets; this stage computes
// per-day positive drift excess max(0, Z_t - 0.5) for mature baselines ($active_days >= {{min_baseline_days}})
// and the Root Stage computes the Windowed Slack Sum W = sum(max(0, Z_t - 0.5)) across the multi-day window (WS6-01).
// True recursive Page's CUSUM (S_t = max(0, S_{t-1} + Z_t - k)) is accumulated in Python (timeline_assembler.py).
stage stage2_daily_drift {
    $entity = $stage1_extract.entity
    $day_ws = $stage1_extract.window_start

  match:
    $entity, $day_ws by 1d

  outcome:
    $observed = max($stage1_extract.observed_val)
    $hist_avg = max($stage1_extract.historical_avg)
    $hist_stddev = max($stage1_extract.historical_stddev)
    $active_days = max($stage1_extract.historical_active_days)
    $hist_max = max($stage1_extract.historical_max)

    // Raw and standardized daily drift with k = 0.5 sigma slack allowance; immature baselines (< min_baseline_days) contribute 0.0
    $raw_drift = $observed - $hist_avg
    $dispersion_floor = math.sqrt(if($hist_avg > 1.0, $hist_avg, 1.0))
    $safe_stddev = if($hist_stddev > $dispersion_floor, $hist_stddev, $dispersion_floor)
    $slack_allowance = 0.5 * $safe_stddev
    $slack_excess = $raw_drift - $slack_allowance
    $daily_z = $raw_drift / $safe_stddev
    $z_minus_slack = $daily_z - 0.5
    $daily_excess = if($active_days >= {{min_baseline_days}} and $z_minus_slack > 0, $z_minus_slack, 0.0)
}

// Stage 3 (Root Stage): Multi-Day Windowed Slack Sum Aggregation Across Window
$entity = $stage2_daily_drift.entity

match:
  $entity

outcome:
  $observed = sum($stage2_daily_drift.observed)
  $peak_daily_observed = max($stage2_daily_drift.observed)
  $hist_avg = max($stage2_daily_drift.hist_avg)
  $hist_stddev = max($stage2_daily_drift.hist_stddev)
  $active_days = max($stage2_daily_drift.active_days)
  $hist_max = max($stage2_daily_drift.hist_max)

  // Windowed Slack Sum W = sum(max(0, Z_t - 0.5)) across all daily buckets in the evaluation window
  $cusum_drift = sum($stage2_daily_drift.daily_excess)
  $windowed_slack_sum = $cusum_drift
  $cusum_drift_score = $cusum_drift
  $drift_days = sum(if($stage2_daily_drift.daily_excess > 0, 1, 0))
  $max_daily_z = max($stage2_daily_drift.daily_z)

// Significance gate: Windowed Slack Sum >= {{anomaly_threshold}} (default 3.0 sigma) across >= 2 drift days.
condition:
  $active_days >= {{min_baseline_days}} and $cusum_drift_score >= {{anomaly_threshold}} and $drift_days >= 2

order:
  $cusum_drift_score desc
