// Stage 2 (Root Stage): Baseline-Maturity Adaptive Context Thresholding
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_avg = max($stage1_extract.historical_avg)
  $hist_stddev = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)

  // 1. Base Parametric Z-Score with Conditional Zero-Variance Safeguard
  $raw_diff = $observed - $hist_avg
  $safe_stddev = if($hist_stddev > 0, $hist_stddev, 1.0)
  $personal_z = $raw_diff / $safe_stddev

  // 2. Baseline-Maturity Adaptive Threshold
  // Sparse baselines ($active_days < 7) require a stricter 3.5-sigma threshold to suppress cold-start noise;
  // mature baselines ($active_days >= 7) use a 2.5-sigma sensitivity threshold.
  $sparse_threshold = 3.5
  $mature_threshold = 2.5
  $effective_threshold = if($active_days < 7, $sparse_threshold, $mature_threshold)

  // 3. Threshold Excess Score (Positive values indicate threshold breach)
  $sensitivity_excess = $personal_z - $effective_threshold

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $sensitivity_excess >= 0.0

order:
  $sensitivity_excess desc
