// Stage 2 (Root Stage): Circadian von Mises Circular Time-of-Day Anomaly
// Evaluates circular distance on the 24-hour clock from a heuristic business-hours center
// (default 14:00 UTC; yields 1.917x at 03:00 UTC via 1 + 11/12 and 2.0x at the 02:00 UTC antipode).
// Normalizes the 30-day daily baseline (period: 1d, window: 30d) to 1-hour units (mean/24, stddev/math.sqrt(24)).
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1h

outcome:
  $observed_hour = max($stage1_extract.observed_val)
  $hist_avg_daily = max($stage1_extract.historical_avg)
  $hist_stddev_daily = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)
  $event_hour = max($stage1_extract.event_hour)

  // 1. Normalize 24-hour baseline to 1-hour expectation (mean / 24.0, stddev / math.sqrt(24) ≈ 4.899)
  $avg_hourly = $hist_avg_daily / 24.0
  $scaled_hourly_sd = $hist_stddev_daily / 4.899
  $dispersion_floor = math.sqrt(if($avg_hourly > 1.0, $avg_hourly, 1.0))
  $safe_stddev_hourly = if($scaled_hourly_sd > $dispersion_floor, $scaled_hourly_sd, $dispersion_floor)
  $hourly_diff = $observed_hour - $avg_hourly
  $hourly_z = $hourly_diff / $safe_stddev_hourly

  // 2. Circular Clock Distance from Heuristic Business-Hours Center (14:00 UTC default)
  $raw_hour_diff = $event_hour - 14.0
  $abs_hour_diff = math.abs($raw_hour_diff)
  $wrap_dist = 24.0 - $abs_hour_diff
  $circ_dist = if($abs_hour_diff > 12.0, $wrap_dist, $abs_hour_diff)

  // 3. Circadian Penalty Multiplier (1.0x at 14:00 UTC -> 1.917x at 03:00 UTC -> 2.0x at 02:00 UTC antipode)
  $norm_dist = $circ_dist / 12.0
  $circadian_weight = 1.0 + $norm_dist

  // 4. Composite Circadian Threat Score (Rectified positive Z weighted by off-hours distance)
  $pos_z = if($hourly_z > 0, $hourly_z, 0.0)
  $circadian_threat_score = $pos_z * $circadian_weight

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $active_days >= {{min_baseline_days}} and $circadian_threat_score >= {{anomaly_threshold}}

order:
  $circadian_threat_score desc
