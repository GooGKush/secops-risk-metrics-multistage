// Stage 2: First-Seen 30-Day Novelty Flag (`PF-11` / `WS1-12`)
// Semantics: `metrics.*(..., metric: first_seen, agg: min)` returns 0 when the bound entity
// or `(entity, sub-key)` tuple was never observed in the 30-day baseline window.
// Reported strictly as a boolean novelty flag + context (`last_seen`, `period_start_for_max`), NEVER as σ.
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $prior_first_seen = min($stage1_extract.prior_first_seen)
  $prior_last_seen = max($stage1_extract.prior_last_seen)
  $peak_period_start = max($stage1_extract.peak_period_start)
  $active_days = max($stage1_extract.historical_active_days)
  $novelty_flag = if($prior_first_seen = 0 and $observed >= {{min_novelty_events}}, 1, 0)

condition:
  $novelty_flag = 1

order:
  $novelty_flag desc
