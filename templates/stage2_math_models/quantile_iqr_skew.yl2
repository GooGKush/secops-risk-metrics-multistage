// Stage 2 Module: 1-Stage Non-Parametric Quantiles, Bowley Skewness & Skew-Adjusted Tukey Fence + Pre-Scoring Raw Z Cross-Check
// Attaches to ANY stage1 extractor (stage1_extract emitting $observed_val per $entity per 1d bucket).
// Multi-key extractors: the router adds every baseline-dimension match key next to $entity in each
// stage's bindings and match (e.g. $sa, $vendor, $product, $resource) and drops non-dimension keys.
//
// WHY THIS IS FASTER & MORE COMPACT THAN 2-STAGE MAD
//   True MAD requires 2 stage-to-stage aggregations (mad_center -> mad_spread) because MAD is a nested
//   median(abs(x - median(x))), consuming 4 total stages. By contrast, window.percentile(val, P) computes
//   all 5 empirical quantiles ($p10, $q25, $q50, $q75, $p90) plus pre-scoring sample statistics in a SINGLE
//   intermediate stage (quantile_envelope), completing the entire pipeline in 3 stages and freeing a stage
//   & join slot for Entity Context Graph (DERIVED_CONTEXT / GLOBAL_CONTEXT) or peer-cohort normalization!
//
// FORMULAS (Bowley 1920; Moors 1988; Hubert & Vandervieren 2008)
//   IQR = Q75 - Q25,  safe_IQR = max(IQR, 0.05 * Q50 + 1.0)
//   Bowley Quartile Skewness: B_skew = (Q75 + Q25 - 2 * Q50) / safe_IQR   in [-1, +1]
//   Interdecile-to-Interquartile Tail-Heaviness Ratio: T_ratio = (P90 - P10) / safe_IQR   (Gaussian = 1.90)
//   Skewness-Adjusted Tukey Upper Fence:
//     adj_upper_fence = Q75 + 1.5 * exp(3.0 * max(0, B_skew)) * safe_IQR
//   tukey_fence_ratio = observed / max(adj_upper_fence, 1.0)
//   Default significance gate: tukey_fence_ratio >= 2.0 (2x the skewness-adjusted upper fence).
//   WS1-03 Cross-Check: $personal_z uses pre-scoring raw active-day sample statistics ($in_scoring_window = 0).
stage quantile_envelope {
    $entity = $stage1_extract.entity

  match:
    $entity

  outcome:
    $p10 = window.percentile($stage1_extract.observed_val, 10)
    $q25 = window.percentile($stage1_extract.observed_val, 25)
    $q50 = window.percentile($stage1_extract.observed_val, 50)
    $q75 = window.percentile($stage1_extract.observed_val, 75)
    $p90 = window.percentile($stage1_extract.observed_val, 90)
    $raw_active_days = count_distinct($stage1_extract.window_start)
    $pre_n = sum($stage1_extract.pre_day)
    $pre_sum = sum($stage1_extract.pre_obs)
    $pre_sum_sq = sum($stage1_extract.pre_obs_sq)
    $historical_active_days = max($stage1_extract.historical_active_days)
    $safe_pre_n = if($pre_n > 0, $pre_n, 1.0)
    $pre_avg = $pre_sum / $safe_pre_n
    $pre_df_raw = $pre_n - 1.0
    $safe_pre_df = if($pre_n > 1, $pre_df_raw, 1.0)
    $raw_var_num = $pre_sum_sq - ($pre_n * $pre_avg * $pre_avg)
    $pre_sd = math.sqrt(if($raw_var_num > 0, $raw_var_num, 0.0) / $safe_pre_df)
    $dispersion_floor = math.sqrt(if($pre_avg > 1.0, $pre_avg, 1.0))
    $safe_pre_sd = if($pre_sd > $dispersion_floor, $pre_sd, $dispersion_floor)
}

// Root Stage: Skewness-Adjusted Tukey Fence & Bowley Asymmetry vs Pre-Scoring Classical Z, scored from {{first_scored_date}} onward
$entity = $stage1_extract.entity
$entity = $quantile_envelope.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_avg = max($quantile_envelope.pre_avg)
  $hist_stddev = max($quantile_envelope.pre_sd)
  $active_days = max($quantile_envelope.pre_n)
  $q25_val = max($quantile_envelope.q25)
  $q50_val = max($quantile_envelope.q50)
  $q75_val = max($quantile_envelope.q75)
  $raw_active_days = max($quantile_envelope.raw_active_days)
  $in_scoring_window = max($stage1_extract.in_scoring_window)

  // 1. Pre-scoring raw active-day Z (cross-check without [D0-59d, D0-29d) stale-anchor shift)
  $safe_stddev = max($quantile_envelope.safe_pre_sd)
  $raw_personal_z = ($observed - $hist_avg) / $safe_stddev
  $personal_z = if($active_days >= {{min_baseline_days}}, $raw_personal_z, 0.0)

  // 2. Non-Parametric IQR, Bowley Quartile Skewness & Tail-Heaviness Ratio
  $iqr = $q75_val - $q25_val
  $q50_floor = $q50_val * 0.05 + 1.0
  $safe_iqr = if($iqr > 0, $iqr, $q50_floor)
  $bowley_skew = ($q75_val + $q25_val - (2.0 * $q50_val)) / $safe_iqr
  $tail_heaviness = (max($quantile_envelope.p90) - max($quantile_envelope.p10)) / $safe_iqr

  // 3. Hubert-Vandervieren Skewness-Adjusted Tukey Upper Fence & Fence Breakout Ratio
  $adj_upper_fence = $q75_val + (1.5 * math.pow(2.718281828, 3.0 * if($bowley_skew > 0, $bowley_skew, 0.0)) * $safe_iqr)
  $safe_fence = if($adj_upper_fence > 0, $adj_upper_fence, 1.0)
  $tukey_fence_ratio = $observed / $safe_fence

condition:
  $in_scoring_window = 1 and $raw_active_days >= {{min_baseline_days}} and $tukey_fence_ratio >= {{fold_change_threshold}}

order:
  $tukey_fence_ratio desc
