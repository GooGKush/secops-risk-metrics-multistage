// Stage 2 Module: TRUE Median Absolute Deviation (MAD) / Modified Z-Score + 30d Metrics Z Cross-Check
// Attaches to ANY stage1 extractor (stage1_extract emitting $observed_val per $entity per 1d bucket).
// Multi-key extractors: the router adds every baseline-dimension match key next to $entity in each
// stage's bindings and match (e.g. $sa, $vendor, $product, $resource) and drops non-dimension keys.
//
// HOW IT WORKS
//   stage1_extract already yields one row per entity per day. When the SEARCH WINDOW spans the
//   raw baseline (recommended 30d; >= {{min_baseline_days}} days required), those daily rows ARE the
//   empirical series. mad_center / mad_spread compute median and MAD over that series natively in
//   SecOps (window.median). No extra event stage is added (2-event-stage ceiling unaffected).
//
// FORMULA (Iglewicz & Hoaglin, 1993)
//   modified_z = (x - median) / robust_scale
//   robust_scale = MAD / 0.6745              when MAD > 0   (== 0.6745 * (x - median) / MAD)
//                = 1.253314 * meanAD         when MAD = 0   (meanAD = mean |x - median|)
//                = 5% of median + 1          when both = 0  (perfectly flat history; tunable floor)
//   Default significance: modified_z >= 3.5.
//
// CROSS-CHECK: $personal_z uses the precomputed 30d metrics.* mean/stddev. $z_gap = modified_z - personal_z.
//   Large positive gap => the 30d mean/stddev were inflated by historic bursts (masking) and the
//   robust score sees an anomaly the classical Z hides.
//   MAD itself never reads metrics.*. The router drops stage1 lookups this root does not read
//   (historical_max / historical_sum), so a MAD query makes 3 metrics lookups per entity-day, not 5.
//
// CAVEATS
//   - Zero-activity days produce no stage1 row: median/MAD are over ACTIVE days only (biased upward
//     for sparse entities). $raw_active_days reports the sample size.
//   - The scored day(s) are included in their own median/MAD (robust to this up to 50% contamination).
//   - Saturation: if the history is flat except the scored day, MAD = 0 and meanAD = |x - median| / N,
//     so modified_z = N / 1.253314 (~23.9 for 30 active days). Still a strong flag, but magnitudes in
//     that regime rank by sample size, not by size of the jump -- read $observed vs $median_val.
//   - REQUIRES stage1_extract to emit the scoring-window flag (the router injects it; add it by hand
//     when composing manually). Date string, never an epoch literal; deterministic, works for
//     historical end dates. first_scored_date = end date minus (scoring_days - 1), UTC YYYY-MM-DD:
//       $in_scoring_window = max(if(timestamp.get_date(metadata.event_timestamp.seconds) >= "{{first_scored_date}}", 1, 0))
//   - window.median(values, should_ignore_zero_values): the 2nd argument MUST be false. `true`
//     discards zero values, and in the MAD stage every day sitting exactly on the median has
//     deviation 0 -- dropping them inflates MAD (live gus-sdl: 29 zeros + one 4 returned MAD=4, not 0).
//     With an even count SecOps returns one of the two middle values (no interpolation).
//   - if() branches must be plain variables/literals (compound arithmetic inside if() is rejected by
//     the compiler), hence the precomputed $scale_from_* variables.
stage mad_center {
    $entity = $stage1_extract.entity

  match:
    $entity

  outcome:
    $median_val = window.median($stage1_extract.observed_val, false)
    $raw_active_days = count_distinct($stage1_extract.window_start)
}

stage mad_spread {
    $entity = $stage1_extract.entity
    $entity = $mad_center.entity

  match:
    $entity

  outcome:
    $mad = window.median(math.abs($stage1_extract.observed_val - $mad_center.median_val), false)
    $mean_abs_dev = avg(math.abs($stage1_extract.observed_val - $mad_center.median_val))
    $median_val = max($mad_center.median_val)
    $raw_active_days = max($mad_center.raw_active_days)
}

// Root Stage: Robust Modified Z (MAD) vs Classical 30d Metrics Z, scored from {{first_scored_date}} onward
$entity = $stage1_extract.entity
$entity = $mad_spread.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_avg = max($stage1_extract.historical_avg)
  $hist_stddev = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)
  $median_val = max($mad_spread.median_val)
  $mad = max($mad_spread.mad)
  $mean_abs_dev = max($mad_spread.mean_abs_dev)
  $raw_active_days = max($mad_spread.raw_active_days)
  $in_scoring_window = max($stage1_extract.in_scoring_window)

  // 1. Classical 30d metrics Z (cross-check)
  $safe_stddev = if($hist_stddev > 0, $hist_stddev, 1.0)
  $personal_z = ($observed - $hist_avg) / $safe_stddev

  // 2. Robust scale with Iglewicz-Hoaglin MAD=0 fallback and flat-history floor
  $scale_from_mad = $mad / 0.6745
  $scale_from_meanad = $mean_abs_dev * 1.253314
  $robust_scale = if($mad > 0, $scale_from_mad, $scale_from_meanad)
  $median_floor = $median_val * 0.05 + 1.0
  $safe_robust_scale = if($robust_scale > 0, $robust_scale, $median_floor)

  // 3. Modified Z-score and masking gap
  $modified_z = ($observed - $median_val) / $safe_robust_scale
  $z_gap = $modified_z - $personal_z

condition:
  $in_scoring_window = 1 and $raw_active_days >= {{min_baseline_days}}

order:
  $modified_z desc
