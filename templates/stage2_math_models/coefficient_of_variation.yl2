// Root Stage: Regular-Volume Surge (Low-CV Predictable Baseline — Preserving Daily Timeline)
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_avg = max($stage1_extract.historical_avg)
  $hist_stddev = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)

  // Coefficient of Variation: sigma / Safe Mu
  $safe_hist_avg = if($hist_avg > 0, $hist_avg, 1.0)
  $cv = $hist_stddev / $safe_hist_avg
  $surge_ratio = $observed / $safe_hist_avg

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $active_days >= {{min_baseline_days}} and $surge_ratio >= {{fold_change_threshold}} and $cv <= 0.5

order:
  $surge_ratio desc
