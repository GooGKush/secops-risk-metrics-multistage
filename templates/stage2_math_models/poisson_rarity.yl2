// Domain note: count-based model (metric: event_count_sum); do not apply to byte-volume metrics (value_sum) where variance scales quadratically.
// Root Stage: Discrete Poisson Rarity Z-Score (Preserving Daily Timeline)
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $k = max($stage1_extract.observed_val)
  $lambda = max($stage1_extract.historical_avg)
  $active_days = max($stage1_extract.historical_active_days)

  // Discrete Poisson Rarity Z-Score: (k - lambda) / math.sqrt(Safe Lambda)
  $diff = $k - $lambda
  $safe_lambda = if($lambda > 0, $lambda, 1.0)
  $sqrt_lambda = math.sqrt($safe_lambda)
  $poisson_z = $diff / $sqrt_lambda

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $poisson_z >= {{anomaly_threshold}}

order:
  $poisson_z desc
