// Stage 2 (Root Stage): Two-Part Zero-Inflated Hurdle Model (Dormant Awakening Volume + Active Intensity)
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_sum = max($stage1_extract.historical_sum)
  $hist_avg = max($stage1_extract.historical_avg)
  $hist_stddev = max($stage1_extract.historical_stddev)
  $hist_max = max($stage1_extract.historical_max)
  $active_days = max($stage1_extract.historical_active_days)

  // Per-calendar-day rate, dormancy & rebuilt 30d calendar statistics (PF-1, PF-2, WS1-05)
  $mu_cal = $hist_sum / 30.0
  $dormant_days = 30.0 - $active_days
  $df_minus_one = if($active_days > 1, $active_days, 1) - 1
  $sum_x2 = ($df_minus_one * $hist_stddev * $hist_stddev) + ($active_days * $hist_avg * $hist_avg)
  $raw_var_cal = ($sum_x2 / 30.0) - ($mu_cal * $mu_cal)
  $sd_cal = math.sqrt(if($raw_var_cal > 0.0, $raw_var_cal, 0.0))

  // Part 1 (Binary Hurdle): Dormant / Immature Entity Awakening (< min_baseline_days, >= min_awakening_volume, > hist_max)
  $is_dormant_awakening = if($active_days < {{min_baseline_days}} and $observed >= {{min_awakening_volume}} and $observed > $hist_max, 1.0, 0.0)
  $awakening_ratio = $observed / if($hist_max > {{min_awakening_volume}}, $hist_max, {{min_awakening_volume}})
  $dormant_score = $is_dormant_awakening * (3.0 + math.log(if($awakening_ratio > 1.0, $awakening_ratio, 1.0)))

  // Part 2 (Active Intensity): Positive rectified Z-Score with D8 floor for mature entities ($active_days >= min_baseline_days)
  $dispersion_floor = math.sqrt(if($hist_avg > 1.0, $hist_avg, 1.0))
  $safe_stddev = if($hist_stddev > $dispersion_floor, $hist_stddev, $dispersion_floor)
  $raw_z = ($observed - $hist_avg) / $safe_stddev
  $intensity_z = if($raw_z > 0.0, $raw_z, 0.0)
  $hurdle_threat_score = if($active_days < {{min_baseline_days}}, $dormant_score, $intensity_z)

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $hurdle_threat_score >= {{anomaly_threshold}}

order:
  $hurdle_threat_score desc
