// Domain note: count-based model (metric: event_count_sum); do not apply to byte-volume metrics (value_sum) where variance scales quadratically.
// Root Stage: Baseline Dispersion Screen — 30-Day Fano Factor (NO-GATE, Preserving Daily Timeline)
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $lambda = max($stage1_extract.historical_avg)
  $stddev = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)

  // Personal Historical Variance: sigma^2 via native math.pow
  $variance = math.pow($stddev, 2)

  // Fano Factor (Index of Dispersion): sigma^2 / Safe Lambda
  $safe_lambda = if($lambda > 0, $lambda, 1.0)
  $fano_factor = $variance / $safe_lambda

// NO-GATE: the Fano factor (sigma^2 / mu) is computed from the 30-day baseline only and does not
// depend on the scored day's value, so a significance threshold does not apply. It ranks entities by
// historical burstiness (a dispersion screen for choosing Poisson vs Gaussian), not by today's anomaly.
order:
  $fano_factor desc
