// Stage 2 (Root Stage): Beta-Binomial Empirical Bayes Proportion Shrinkage
// Normalizes raw count/volume inputs into [0, 1] proportions when paired with count/volume extractors,
// while preserving exact [0, 1] ratios when paired with proportion extractors.
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_avg = max($stage1_extract.historical_avg)
  $active_days = max($stage1_extract.historical_active_days)

  // Normalize to [0, 1] when inputs exceed 1.0 (e.g. count or volume Stage 1 extractors)
  $denom_scale = $observed + $hist_avg + 1.0
  $scaled_prior = $hist_avg / $denom_scale
  $scaled_obs = $observed / $denom_scale
  $prior_rate = if($hist_avg <= 1.0 and $observed <= 1.0, $hist_avg, $scaled_prior)
  $obs_rate = if($hist_avg <= 1.0 and $observed <= 1.0, $observed, $scaled_obs)

  // Beta Prior Parameters (M = 10 equivalent pseudo-trials, bounded in [0, 10])
  $prior_alpha = $prior_rate * 10.0
  $prior_beta = (1.0 - $prior_rate) * 10.0

  // Posterior Mean Rate after N = 10 pseudo-trial observations
  $post_alpha = $prior_alpha + ($obs_rate * 10.0)
  $post_denom = $prior_alpha + $prior_beta + 10.0
  $posterior_rate = $post_alpha / $post_denom
  $safe_prior = if($prior_rate > 0.001, $prior_rate, 0.001)
  $posterior_lift = $posterior_rate / $safe_prior

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $posterior_lift >= {{fold_change_threshold}}

order:
  $posterior_lift desc
