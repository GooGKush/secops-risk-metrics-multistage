// Root Stage: Beta-Binomial Bayesian Ratio Regularization (Preserving Daily Timeline)
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed_fails = max($stage1_extract.observed_val)
  $avg_fail_prob = max($stage1_extract.historical_avg)
  $stddev_p = max($stage1_extract.historical_stddev)
  $variance_p = ($stddev_p * $stddev_p) + 0.001
  $active_days = max($stage1_extract.historical_active_days)

  // 1. Beta Prior Parameterization via Method of Moments
  $sample_factor = (($avg_fail_prob * ($avg_fail_prob + 1.0)) / ($variance_p + 0.001))
  $alpha_prior = $avg_fail_prob * $sample_factor
  $beta_prior = ($avg_fail_prob + 1.0) * $sample_factor

  // 2. Conjugate Posterior Updating with Daily Evidence
  $alpha_post = $alpha_prior + $observed_fails
  $beta_post = $beta_prior + 1.0

  // 3. Regularized Posterior Failure Probability
  $posterior_fail_prob = $alpha_post / ($alpha_post + $beta_post)

order:
  $posterior_fail_prob desc
