// Stage 2: Cross-Sectional Fleet Wave Aggregation (Stage-to-Stage Source)
// Counts distinct entities active in the same 1d bucket across the fleet so concurrent
// enterprise-wide rollouts ("Patch Tuesday" waves) dampen personal Z-scores.
stage stage2_fleet_wave {
    $day_ws = $stage1_extract.window_start

  match:
    $day_ws by 1d

  outcome:
    $fleet_entities = count_distinct($stage1_extract.entity)
}

// Stage 3 (Root Stage): Fleet Prevalence Shield ("Patch Tuesday" Immunity)
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start
$day_ws = $stage1_extract.window_start
$day_ws = $stage2_fleet_wave.day_ws

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_avg = max($stage1_extract.historical_avg)
  $hist_stddev = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)

  // 1. Personal Parametric Z-Score with Conditional Zero-Variance Safeguard
  $raw_diff = $observed - $hist_avg
  $safe_stddev = if($hist_stddev > 0, $hist_stddev, 1.0)
  $personal_z = $raw_diff / $safe_stddev

  // 2. Concurrent Fleet Prevalence (distinct entities active in the same 1d window)
  $fleet_count = max($stage2_fleet_wave.fleet_entities)

  // 3. Inverse Log-Prevalence Dampening Factor
  $log_fleet = math.log($fleet_count)
  $prevalence_factor = 1.0 + $log_fleet
  $shielded_z = $personal_z / $prevalence_factor

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $shielded_z >= {{anomaly_threshold}}

order:
  $shielded_z desc
