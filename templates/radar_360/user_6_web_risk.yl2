// ============================================================================
// ARCHITECTURE: CANONICAL 360° RADAR SECTOR 6 (USER) — Web & Proxy Activity
// Copy verbatim; substitute only {{entity_id}} with the verified user.userid.
// ============================================================================

stage web_risk {
    (network.http.method != "" or network.http.user_agent != "" or network.http.response_code != 0 or network.http.referral_url != "")
    principal.user.userid = "{{entity_id}}"
    $user = principal.user.userid

  match:
    $user by 1d

  outcome:
    $obs = count(metadata.id)
    $avg = max(metrics.http_queries_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.user.userid: principal.user.userid
    ))
    $std = max(metrics.http_queries_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.user.userid: principal.user.userid
    ))
    $days = max(metrics.http_queries_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.user.userid: principal.user.userid
    ))
    $floor = math.sqrt(if($avg > 1.0, $avg, 1.0))
    $safe_std = if($std > $floor, $std, $floor)
    $raw_z = ($obs - $avg) / $safe_std
    $z = if($days >= 7, $raw_z, 0.0)
}

$user = $web_risk.user

match:
  $user by 1d

outcome:
  $z = max($web_risk.z)
  $observed = max($web_risk.obs)
  $baseline = max($web_risk.avg)
  $dispersion = max($web_risk.std)
  $active_days = max($web_risk.days)

// NO-GATE: 360 radar sector micro-query; every sector is reported and fused client-side.
order:
  $z desc
