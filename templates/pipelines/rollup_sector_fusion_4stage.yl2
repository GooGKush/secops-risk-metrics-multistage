// ============================================================================
// ARCHITECTURE: 4-STAGE ROLL-UP SECTOR FUSION (COMPOSITE-ONLY METRIC + ENTITY-KEYED METRIC)
// Skill: secops-risk-metrics-multistage
// Sector A: {{sector_a_label}}
// Sector B: {{sector_b_label}}
// Purpose: Fuses a composite-only metric, which has no entity-only baseline, with an entity-keyed metric
//          for the same entity using a shared entity-union spine (missing sector contributes 0.0).
// Stages: sector_a_detail (UDM 1 of 2, union spine) -> sector_a (roll-up, stage-to-stage) ;
//         sector_b (UDM 2 of 2, union spine) -> root
// Math: per detail key k, Z_k = (obs_k - mu_k) / sigma_k, rectified, 0 until k has {{min_baseline_days}} active days;
//       Z_a = max(0, max_k(Z_k) - sqrt(2 * ln(max(K_active, 1)))) ; D^2 = Z_a^2 + Z_b^2
//       Note (WS7-03): sqrt(2 * ln(K_eff)) is an approximation of the Gaussian expected maximum across K_eff
//       active sub-keys — NOT a Bonferroni correction; fusion false-positive rates also depend on inter-sector correlation.
//       Z_a answers "is any one binary / product / rule unusual for this entity after multiplicity adjustment",
//       NOT "is the entity's total volume unusual": the compiler has no entity-only baseline for composite-only metrics.
//
// SLOT FILLING: every value comes from references/metric-sector-catalog.md
//   Sector A (the metric's "Roll-up sector sets" block; pick the set that contains your entity's dimension):
//     sector_a_event_filter        "Observed event filter" predicate expression
//     sector_a_companion_nonempty  non-empty guards for Sector A companion fields inside Sector A's union branch
//     sector_a_entity_field        an identifier field of the set's entity dimension (e.g. principal.asset.hostname)
//     sector_a_companion_bindings  top-level companion field bindings, one per line, indented 4 spaces
//     sector_a_match_keys          $entity followed by every companion placeholder, comma-separated
//     sector_a_metric_filters      entity field: entity field, then every companion "field: field", comma-separated
//     sector_a_detail_key          the set's "Distinct key" placeholder name without the leading $
//     sector_a_union_observed_agg / sector_a_metric / sector_a_metric_arg  conditional observed value & metric args
//   Sector B: an entity-keyed metric on the same union spine (sector_b_union_observed_agg, sector_b_metric, ...)
// PAIRING RULES: the same as the other fusion templates (same entity kind and identifier on both sides; never
//   user <-> host), plus: exactly one sector may be a roll-up. Keep the "// ADVISORY:" roll-up line.
// ============================================================================

// --- STAGE 1: Sector A detail (UDM Source 1 of 2, union spine): one row per entity and companion key ---
stage sector_a_detail {
    (({{sector_a_event_filter}}{{sector_a_companion_nonempty}}) or ({{sector_b_event_filter}}))
    {{sector_entity_binding}}
    $entity != ""
    {{sector_a_companion_bindings}}

  match:
    {{sector_a_match_keys}} by 1d

  outcome:
    $d_obs = {{sector_a_union_observed_agg}}
    $d_avg = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: avg,
        {{sector_a_metric_filters}}
    ))
    $d_std = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: stddev,
        {{sector_a_metric_filters}}
    ))
    $d_days = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: num_metric_periods,
        {{sector_a_metric_filters}}
    ))
    $d_floor = math.sqrt(if($d_avg > 1.0, $d_avg, 1.0))
    $d_z_raw = ($d_obs - $d_avg) / if($d_std > $d_floor, $d_std, $d_floor)
    $d_z_pos = if($d_z_raw > 0, $d_z_raw, 0.0)
    $d_z = if($d_obs > 0 and $d_days >= {{min_baseline_days}}, $d_z_pos, 0.0)
    $d_hot = if($d_obs > 0 and $d_days >= {{min_baseline_days}} and $d_z_raw >= 3.0, 1, 0)
    $d_novel = if($d_obs > 0 and $d_days = 0, 1, 0)
    $d_active = if($d_obs > 0, 1, 0)
}

// --- STAGE 2: Sector A roll-up (stage-to-stage): one row per entity with K-key multiplicity offset ---
stage sector_a {
    $entity = $sector_a_detail.entity

  match:
    $entity by 1d

  outcome:
    $a_obs = sum($sector_a_detail.d_obs)
    $a_keys = count_distinct($sector_a_detail.{{sector_a_detail_key}})
    $a_active_keys = sum($sector_a_detail.d_active)
    $a_hot_keys = sum($sector_a_detail.d_hot)
    $a_novel_keys = sum($sector_a_detail.d_novel)
    $a_days = max($sector_a_detail.d_days)
    $z_a_max = max($sector_a_detail.d_z)
    $k_eff = if($a_active_keys > 1, $a_active_keys, 1)
    $multiplicity_offset = math.sqrt(2.0 * math.log($k_eff))
    $z_a_adj = $z_a_max - $multiplicity_offset
    $z_a = if($z_a_adj > 0.0, $z_a_adj, 0.0)
}

// --- STAGE 3: Sector B (UDM Source 2 of 2, union spine so single-sector Sector A rows survive) ---
stage sector_b {
    (({{sector_a_event_filter}}{{sector_a_companion_nonempty}}) or ({{sector_b_event_filter}}))
    {{sector_entity_binding}}
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $b_obs = {{sector_b_union_observed_agg}}
    $b_avg = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: avg,
        {{sector_b_entity_field}}: {{sector_b_entity_field}}
    ))
    $b_std = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: stddev,
        {{sector_b_entity_field}}: {{sector_b_entity_field}}
    ))
    $b_days = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: num_metric_periods,
        {{sector_b_entity_field}}: {{sector_b_entity_field}}
    ))
    $b_floor = math.sqrt(if($b_avg > 1.0, $b_avg, 1.0))
    $z_b_raw = ($b_obs - $b_avg) / if($b_std > $b_floor, $b_std, $b_floor)
    $z_b_pos = if($z_b_raw > 0, $z_b_raw, 0.0)
    $z_b = if($b_obs > 0 and $b_days >= {{min_baseline_days}}, $z_b_pos, 0.0)
}

// --- ROOT STAGE: Roll-Up Sector Fusion & Distance Scoring ---
$entity = $sector_a.entity
$entity = $sector_b.entity
$ws = $sector_a.window_start
$ws = $sector_b.window_start

match:
  $entity, $ws by 1d

outcome:
  $a_observed = max($sector_a.a_obs)
  $a_keys = max($sector_a.a_keys)
  $a_hot_keys = max($sector_a.a_hot_keys)
  $a_novel_keys = max($sector_a.a_novel_keys)
  $b_observed = max($sector_b.b_obs)
  $b_active_days = max($sector_b.b_days)

  // Rectified, baseline-gated, multiplicity-adjusted sector scores (missing sector contributes 0.0)
  $z_a = max($sector_a.z_a)
  $z_b = max($sector_b.z_b)

  // Euclidean Vector Threat Norm D^2 = Z_a^2 + Z_b^2
  $z_a_sq = $z_a * $z_a
  $z_b_sq = $z_b * $z_b
  $composite_threat_norm_sq = $z_a_sq + $z_b_sq

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $composite_threat_norm_sq >= {{fusion_threshold_sq}}

order:
  $composite_threat_norm_sq desc
