// ============================================================================
// ARCHITECTURE: 4-STAGE ROLL-UP SECTOR FUSION (COMPOSITE-ONLY METRIC + ENTITY-KEYED METRIC)
// Skill: secops-risk-metrics-multistage
// Sector A: {{sector_a_label}}
// Sector B: {{sector_b_label}}
// Purpose: Fuses a composite-only metric (file_executions_*, resource_*, alert_event_name_count), which has
//          no entity-only baseline, with an entity-keyed metric for the same entity.
// Stages: sector_a_detail (UDM 1 of 2) -> sector_a (roll-up, stage-to-stage) ; sector_b (UDM 2 of 2) -> root
// Math: per detail key k, Z_k = (obs_k - mu_k) / sigma_k, rectified, 0 until k has {{min_baseline_days}} active days
//       Z_a = max over k of Z_k ; D^2 = Z_a^2 + Z_b^2
//       Z_a answers "is any one binary / product / rule unusual for this entity", NOT "is the entity's total
//       volume unusual": the compiler has no entity-only baseline for composite-only metrics.
//
// SLOT FILLING: every value comes from references/metric-sector-catalog.md
//   Sector A (the metric's "Roll-up sector sets" block; pick the set that contains your entity's dimension):
//     sector_a_event_filter        "Observed event filter" lines, one per line, indented 4 spaces
//     sector_a_entity_field        an identifier field of the set's entity dimension (e.g. principal.asset.hostname)
//     sector_a_companion_bindings  "Detail bindings" lines of the set, one per line, indented 4 spaces
//     sector_a_match_keys          $entity followed by every companion placeholder, comma-separated
//     sector_a_metric_filters      entity field: $entity, then every companion "field: $placeholder", comma-separated
//     sector_a_detail_key          the set's "Distinct key" placeholder name without the leading $
//     sector_a_observed_agg / sector_a_metric / sector_a_metric_arg  as for any sector
//   Sector B: an entity-keyed metric, filled exactly as in dual_sector_fusion_3stage.yl2
// PAIRING RULES: the same as the other fusion templates (same entity kind and identifier on both sides; never
//   user <-> host), plus: exactly one sector may be a roll-up. Keep the "// ADVISORY:" roll-up line.
// ============================================================================

// --- STAGE 1: Sector A detail (UDM Source 1 of 2): one row per entity and companion key ---
stage sector_a_detail {
    {{sector_a_event_filter}}
    {{sector_a_entity_field}} = $entity
    $entity != ""
    {{sector_a_companion_bindings}}

  match:
    {{sector_a_match_keys}} by 1d

  outcome:
    $d_obs = {{sector_a_observed_agg}}
    $d_avg = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: avg,
        {{sector_a_metric_filters}}
    ))
    $d_std = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: stddev,
        {{sector_a_metric_filters}}
    ))
    $d_days = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: num_metric_periods,
        {{sector_a_metric_filters}}
    ))
    $d_z_raw = ($d_obs - $d_avg) / if($d_std > 0, $d_std, 1.0)
    $d_z = if($d_days >= {{min_baseline_days}} and $d_z_raw > 0, $d_z_raw, 0.0)
    $d_hot = if($d_days >= {{min_baseline_days}} and $d_z_raw >= 3.0, 1, 0)
    $d_novel = if($d_days = 0, 1, 0)
}

// --- STAGE 2: Sector A roll-up (stage-to-stage): one row per entity ---
stage sector_a {
    $entity = $sector_a_detail.entity

  match:
    $entity by 1d

  outcome:
    $a_obs = sum($sector_a_detail.d_obs)
    $a_keys = count_distinct($sector_a_detail.{{sector_a_detail_key}})
    $a_hot_keys = sum($sector_a_detail.d_hot)
    $a_novel_keys = sum($sector_a_detail.d_novel)
    $a_days = max($sector_a_detail.d_days)
    $z_a = max($sector_a_detail.d_z)
}

// --- STAGE 3: Sector B (UDM Source 2 of 2) ---
stage sector_b {
    {{sector_b_event_filter}}
    {{sector_b_entity_field}} = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $b_obs = {{sector_b_observed_agg}}
    $b_avg = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: avg,
        {{sector_b_entity_field}}: $entity
    ))
    $b_std = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: stddev,
        {{sector_b_entity_field}}: $entity
    ))
    $b_days = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: num_metric_periods,
        {{sector_b_entity_field}}: $entity
    ))
    $z_b_raw = ($b_obs - $b_avg) / if($b_std > 0, $b_std, 1.0)
    $z_b_pos = if($z_b_raw > 0, $z_b_raw, 0.0)
    $z_b = if($b_days >= {{min_baseline_days}}, $z_b_pos, 0.0)
}

// --- ROOT STAGE: Roll-Up Sector Fusion & Distance Scoring ---
$entity = $sector_a.entity
$entity = $sector_b.entity

match:
  $entity by 1d

outcome:
  $a_observed = max($sector_a.a_obs)
  $a_keys = max($sector_a.a_keys)
  $a_hot_keys = max($sector_a.a_hot_keys)
  $a_novel_keys = max($sector_a.a_novel_keys)
  $b_observed = max($sector_b.b_obs)
  $b_active_days = max($sector_b.b_days)

  // Rectified, baseline-gated sector scores (per-key gate in Stage 1, entity gate in Stage 3)
  $z_a = max($sector_a.z_a)
  $z_b = max($sector_b.z_b)

  // Euclidean Vector Threat Norm D^2 = Z_a^2 + Z_b^2
  $z_a_sq = $z_a * $z_a
  $z_b_sq = $z_b * $z_b
  $composite_threat_norm_sq = $z_a_sq + $z_b_sq

order:
  $composite_threat_norm_sq desc
