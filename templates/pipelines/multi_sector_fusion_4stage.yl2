// ============================================================================
// ARCHITECTURE: 4-STAGE MULTI-SECTOR THREAT FUSION (AUTH + PROCESS + NETWORK)
// Skill: secops-risk-metrics-multistage
// Purpose: Fuses orthogonal anomaly signals across IAM, Endpoint, and Network into a single composite threat vector norm
// Math: Composite Threat Norm D = sqrt(Z_auth^2 + Z_proc^2 + Z_net^2)
// ============================================================================

// --- STAGE 1: Sector 1 - Authentication / Credential Access ---
stage auth_sector {
    metadata.event_type = "USER_LOGIN"
    security_result.action = "BLOCK"
    principal.asset.hostname = $host
    $host != ""

  match:
    $host by 1d

  outcome:
    $auth_obs = count(metadata.id)
    $auth_avg = max(metrics.auth_attempts_fail(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.asset.hostname: $host
    ))
    $auth_std = max(metrics.auth_attempts_fail(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.asset.hostname: $host
    ))
}

// --- STAGE 2: Sector 2 - Endpoint / Suspicious Process Execution ---
stage proc_sector {
    metadata.event_type = "PROCESS_LAUNCH"
    principal.asset.hostname = $host
    $host != ""

  match:
    $host by 1d

  outcome:
    $proc_obs = count(metadata.id)
    $proc_avg = max(metrics.file_executions_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.asset.hostname: $host
    ))
    $proc_std = max(metrics.file_executions_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.asset.hostname: $host
    ))
}

// --- STAGE 3: Sector 3 - Network / Egress Data Volume ---
stage net_sector {
    metadata.event_type = "NETWORK_CONNECTION"
    principal.asset.hostname = $host
    $host != ""

  match:
    $host by 1d

  outcome:
    $net_bytes_obs = sum(network.sent_bytes)
    $net_bytes_avg = max(metrics.network_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: avg,
        principal.asset.hostname: $host
    ))
    $net_bytes_std = max(metrics.network_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: stddev,
        principal.asset.hostname: $host
    ))
}

// --- STAGE 4 (ROOT STAGE): Multi-Sector Threat Fusion & Distance Scoring ---
$host = $auth_sector.host
$host = $proc_sector.host
$host = $net_sector.host

$ws = $auth_sector.window_start
$ws = $proc_sector.window_start
$ws = $net_sector.window_start

match:
  $host, $ws by 1d

outcome:
  $a_obs = max($auth_sector.auth_obs)
  $p_obs = max($proc_sector.proc_obs)
  $n_obs = max($net_sector.net_bytes_obs)

  // Sector 1: Auth Z-Score
  $a_diff = $a_obs - max($auth_sector.auth_avg)
  $z_auth = $a_diff / max($auth_sector.auth_std)

  // Sector 2: Process Z-Score
  $p_diff = $p_obs - max($proc_sector.proc_avg)
  $z_proc = $p_diff / max($proc_sector.proc_std)

  // Sector 3: Network Z-Score
  $n_diff = $n_obs - max($net_sector.net_bytes_avg)
  $z_net = $n_diff / max($net_sector.net_bytes_std)

  // Euclidean Vector Threat Norm D^2 = Z_auth^2 + Z_proc^2 + Z_net^2
  $z_auth_sq = $z_auth * $z_auth
  $z_proc_sq = $z_proc * $z_proc
  $z_net_sq = $z_net * $z_net
  $composite_threat_norm_sq = $z_auth_sq + $z_proc_sq + $z_net_sq

order:
  $composite_threat_norm_sq desc

