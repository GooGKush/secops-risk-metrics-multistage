// ============================================================================
// ARCHITECTURE: 4-STAGE MULTI-SECTOR THREAT FUSION (GENERIC: SECTOR A + SECTOR B + FLEET NORM -> ROOT)
// Skill: secops-risk-metrics-multistage
// Sector A: {{sector_a_label}}
// Sector B: {{sector_b_label}}
// Purpose: Fuses two independent anomaly signals for the same entity, plus each signal's deviation from the
//          fleet-wide mean for the day, into one composite threat vector norm
// Source Accounting: 2 UDM stages (sector_a, sector_b) <= 2 UDM limit + 1 stage-to-stage fleet norm + 1 root = 4 stages
// Math: D^2 = Z_a^2 + Z_b^2 + dZ_a^2 + dZ_b^2, where dZ_x = max(0, Z_x - fleet mean of Z_x for the day)
//       A sector scores 0 until its baseline has {{min_baseline_days}} active days (gated before the fleet mean).
//
// SLOT FILLING: take every value from the metric's row in references/metric-sector-catalog.md
//   sector_X_event_filter      "Observed event filter" lines, one per line, indented 4 spaces
//   sector_X_observed_agg      "Observed value" expression
//   sector_X_metric            metric name (metrics.<name>)
//   sector_X_metric_arg        "metric:" argument (value_sum for *_bytes_* metrics, else event_count_sum)
//   sector_X_entity_field      one of the metric's "Entity identifier fields"
// PAIRING RULES (apply them yourself; full list in references/metric-sector-catalog.md):
//   1. Same entity kind in both sectors: user <-> user or device <-> device. Never user <-> host.
//   2. Same identifier in both sectors: userid <-> userid, hostname <-> hostname, email_addresses <-> email_addresses.
//      Principal vs. target does not matter (target.user.userid joins principal.user.userid).
//   3. Each entity field must be listed for its metric (the compiler's exact dimension-set rule).
//   4. Composite-only metrics (file_executions_*, resource_*, alert_event_name_count) have no entity-only
//      baseline; use rollup_sector_fusion_4stage.yl2 / _5stage.yl2 to make one of them a roll-up sector.
// ============================================================================

// --- STAGE 1: Sector A (UDM Source 1 of 2) ---
stage sector_a {
    {{sector_a_event_filter}}
    {{sector_a_entity_field}} = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $a_obs = {{sector_a_observed_agg}}
    $a_avg = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: avg,
        {{sector_a_entity_field}}: $entity
    ))
    $a_std = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: stddev,
        {{sector_a_entity_field}}: $entity
    ))
    $a_days = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: num_metric_periods,
        {{sector_a_entity_field}}: $entity
    ))
    $z_a_raw = ($a_obs - $a_avg) / if($a_std > 0, $a_std, 1.0)
    $z_a_pos = if($z_a_raw > 0, $z_a_raw, 0.0)
    $z_a = if($a_days >= {{min_baseline_days}}, $z_a_pos, 0.0)
}

// --- STAGE 2: Sector B (UDM Source 2 of 2) ---
stage sector_b {
    {{sector_b_event_filter}}
    {{sector_b_entity_field}} = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $b_obs = {{sector_b_observed_agg}}
    $b_avg = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: avg,
        {{sector_b_entity_field}}: $entity
    ))
    $b_std = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: stddev,
        {{sector_b_entity_field}}: $entity
    ))
    $b_days = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: num_metric_periods,
        {{sector_b_entity_field}}: $entity
    ))
    $z_b_raw = ($b_obs - $b_avg) / if($b_std > 0, $b_std, 1.0)
    $z_b_pos = if($z_b_raw > 0, $z_b_raw, 0.0)
    $z_b = if($b_days >= {{min_baseline_days}}, $z_b_pos, 0.0)
}

// --- STAGE 3: Cross-Sectional Fleet Sector Normalization (Stage-to-Stage Source) ---
stage fleet_sector_norm {
    $ws = $sector_a.window_start
    $ws = $sector_b.window_start
    $e = $sector_a.entity
    $e = $sector_b.entity

  match:
    $ws

  outcome:
    $fleet_z_a_avg = avg($sector_a.z_a)
    $fleet_z_b_avg = avg($sector_b.z_b)
}

// --- ROOT STAGE: Multi-Sector Threat Fusion & Distance Scoring ---
$entity = $sector_a.entity
$entity = $sector_b.entity
$ws = $sector_a.window_start
$ws = $sector_b.window_start
$ws = $fleet_sector_norm.ws

match:
  $entity, $ws by 1d

outcome:
  $a_observed = max($sector_a.a_obs)
  $b_observed = max($sector_b.b_obs)
  $a_active_days = max($sector_a.a_days)
  $b_active_days = max($sector_b.b_days)

  // Personal sector Z-scores (already rectified and baseline-gated in Stages 1-2)
  $z_a = max($sector_a.z_a)
  $z_b = max($sector_b.z_b)

  // Fleet-normalized sector Delta-Z scores from Stage 3
  $fleet_a_mu = max($fleet_sector_norm.fleet_z_a_avg)
  $fleet_b_mu = max($fleet_sector_norm.fleet_z_b_avg)
  $dz_a_raw = $z_a - $fleet_a_mu
  $dz_b_raw = $z_b - $fleet_b_mu
  $delta_z_a = if($dz_a_raw > 0, $dz_a_raw, 0.0)
  $delta_z_b = if($dz_b_raw > 0, $dz_b_raw, 0.0)

  // Euclidean Vector Threat Norm D^2 = Z_a^2 + Z_b^2 + dZ_a^2 + dZ_b^2
  $z_a_sq = $z_a * $z_a
  $z_b_sq = $z_b * $z_b
  $dz_a_sq = $delta_z_a * $delta_z_a
  $dz_b_sq = $delta_z_b * $delta_z_b
  $composite_threat_norm_sq = $z_a_sq + $z_b_sq + $dz_a_sq + $dz_b_sq

order:
  $composite_threat_norm_sq desc
