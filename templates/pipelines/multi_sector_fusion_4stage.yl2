// ============================================================================
// ARCHITECTURE: MULTI-SECTOR THREAT FUSION (GENERIC: SECTOR UNION + MATURE FLEET MEDIAN NORM -> ROOT)
// Skill: secops-risk-metrics-multistage
// Sector A: {{sector_a_label}}
// Sector B: {{sector_b_label}}
// Purpose: Fuses two independent anomaly signals for the same entity (without inner-join drop), normalized
//          against the mature fleet median of each sector for the day, into one composite threat vector norm
// Source Accounting: 1 UDM union stage (sector_union) <= 2 UDM limit + 1 stage-to-stage mature fleet norm + 1 root
// Math: D^2 = dZ_a^2 + dZ_b^2, where dZ_x = max(0, Z_x - mature fleet median of Z_x for the day);
//       personal_norm_sq = Z_a^2 + Z_b^2 tracked separately to avoid collinear double-counting.
//       A missing sector or baseline with < {{min_baseline_days}} active days scores 0.0.
//
// SLOT FILLING: take every value from the metric's row in references/metric-sector-catalog.md
//   sector_X_event_filter        "Observed event filter" predicate expression
//   sector_X_union_observed_agg  conditional sum isolating sector X events (1.0/0.0 * bytes for byte metrics)
//   sector_X_metric              metric name (metrics.<name>)
//   sector_X_metric_arg          "metric:" argument (value_sum for *_bytes_* metrics, else event_count_sum)
//   sector_X_entity_field        one of the metric's "Entity identifier fields"
//   sector_entity_binding        top-level entity binding (field = $entity or strings.coalesce)
// PAIRING RULES (apply them yourself; full list in references/metric-sector-catalog.md):
//   1. Same entity kind in both sectors: user <-> user or device <-> device. Never user <-> host.
//   2. Same identifier in both sectors: userid <-> userid, hostname <-> hostname, email_addresses <-> email_addresses.
//      Principal vs. target does not matter (target.user.userid joins principal.user.userid).
//   3. Each entity field must be listed for its metric (the compiler's exact dimension-set rule).
//   4. Composite-only metrics (file_executions_*, resource_*, alert_event_name_count) have no entity-only
//      baseline; use rollup_sector_fusion_4stage.yl2 / _5stage.yl2 to make one of them a roll-up sector.
// ============================================================================

// --- STAGE 1: Single-Stage Sector Union (UDM Source 1 of 2; preserves single-sector outliers) ---
stage sector_union {
    (({{sector_a_event_filter}}) or ({{sector_b_event_filter}}))
    {{sector_entity_binding}}
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $a_obs = {{sector_a_union_observed_agg}}
    $a_avg = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: avg,
        {{sector_a_entity_field}}: {{sector_a_entity_field}}
    ))
    $a_std = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: stddev,
        {{sector_a_entity_field}}: {{sector_a_entity_field}}
    ))
    $a_days = max(metrics.{{sector_a_metric}}(
        period: 1d, window: 30d, metric: {{sector_a_metric_arg}}, agg: num_metric_periods,
        {{sector_a_entity_field}}: {{sector_a_entity_field}}
    ))
    $a_floor = math.sqrt(if($a_avg > 1.0, $a_avg, 1.0))
    $z_a_raw = ($a_obs - $a_avg) / if($a_std > $a_floor, $a_std, $a_floor)
    $z_a_pos = if($z_a_raw > 0, $z_a_raw, 0.0)
    $z_a = if($a_obs > 0 and $a_days >= {{min_baseline_days}}, $z_a_pos, 0.0)
    $z_a_winsor = if($z_a > 6.0, 6.0, $z_a)

    $b_obs = {{sector_b_union_observed_agg}}
    $b_avg = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: avg,
        {{sector_b_entity_field}}: {{sector_b_entity_field}}
    ))
    $b_std = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: stddev,
        {{sector_b_entity_field}}: {{sector_b_entity_field}}
    ))
    $b_days = max(metrics.{{sector_b_metric}}(
        period: 1d, window: 30d, metric: {{sector_b_metric_arg}}, agg: num_metric_periods,
        {{sector_b_entity_field}}: {{sector_b_entity_field}}
    ))
    $b_floor = math.sqrt(if($b_avg > 1.0, $b_avg, 1.0))
    $z_b_raw = ($b_obs - $b_avg) / if($b_std > $b_floor, $b_std, $b_floor)
    $z_b_pos = if($z_b_raw > 0, $z_b_raw, 0.0)
    $z_b = if($b_obs > 0 and $b_days >= {{min_baseline_days}}, $z_b_pos, 0.0)
    $z_b_winsor = if($z_b > 6.0, 6.0, $z_b)
}

// --- STAGE 2: Mature-Only Robust Fleet Sector Normalization (Stage-to-Stage Source) ---
stage fleet_sector_norm {
    $ws = $sector_union.window_start
    $e = $sector_union.entity
    ($sector_union.a_days >= {{min_baseline_days}} or $sector_union.b_days >= {{min_baseline_days}})

  match:
    $ws by 1d

  outcome:
    $fleet_z_a_median = window.median($sector_union.z_a, false)
    $fleet_z_b_median = window.median($sector_union.z_b, false)
    $fleet_z_a_winsor_avg = avg($sector_union.z_a_winsor)
    $fleet_z_b_winsor_avg = avg($sector_union.z_b_winsor)
}

// --- ROOT STAGE: Multi-Sector Threat Fusion & Distance Scoring ---
$entity = $sector_union.entity
$ws = $sector_union.window_start
$ws = $fleet_sector_norm.ws

match:
  $entity, $ws by 1d

outcome:
  $a_observed = max($sector_union.a_obs)
  $b_observed = max($sector_union.b_obs)
  $a_active_days = max($sector_union.a_days)
  $b_active_days = max($sector_union.b_days)

  // Personal sector Z-scores (rectified and baseline-gated in Stage 1)
  $z_a = max($sector_union.z_a)
  $z_b = max($sector_union.z_b)

  // Robust mature-fleet sector Delta-Z scores from Stage 2
  $fleet_a_mu = max($fleet_sector_norm.fleet_z_a_median)
  $fleet_b_mu = max($fleet_sector_norm.fleet_z_b_median)
  $dz_a_raw = $z_a - $fleet_a_mu
  $dz_b_raw = $z_b - $fleet_b_mu
  $delta_z_a = if($dz_a_raw > 0, $dz_a_raw, 0.0)
  $delta_z_b = if($dz_b_raw > 0, $dz_b_raw, 0.0)

  // Euclidean Vector Threat Norm D^2 = dZ_a^2 + dZ_b^2 (with personal_norm_sq tracked separately)
  $z_a_sq = $z_a * $z_a
  $z_b_sq = $z_b * $z_b
  $dz_a_sq = $delta_z_a * $delta_z_a
  $dz_b_sq = $delta_z_b * $delta_z_b
  $personal_norm_sq = $z_a_sq + $z_b_sq
  $composite_threat_norm_sq = $dz_a_sq + $dz_b_sq

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $composite_threat_norm_sq >= {{fusion_threshold_sq}}

order:
  $composite_threat_norm_sq desc
