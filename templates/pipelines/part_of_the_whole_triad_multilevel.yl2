// ============================================================================
// ARCHITECTURE: 3-METRIC MULTILEVEL PART-OF-THE-WHOLE TRIAD DAG
// Skill: secops-risk-metrics-multistage
// Purpose: Evaluates an individual against their personal 30-day baseline and
//          the fleet (enterprise whole) across three sibling metrics within the
//          same UDM event stream; optionally also against a named peer cohort.
// Math: Multilevel Triad Z-Scores (Personal, Fleet[, Team]) + Composite D_fleet^2
//
// PEER GROUP (default = fleet only):
//   No peers mentioned -> delete every block between "// >>> TEAM COHORT" and
//   "// <<< TEAM COHORT" (4 blocks) and keep "order: $d_vs_fleet_sq desc". Without a peer
//   list the team stage would just recompute the fleet.
//   Peers mentioned but not named (e.g. "vs his team") -> resolve the team from Active
//   Directory in Turn 1 (AD TEAM LOOKUP in references/multi-stage-metrics-guide.md, Peer
//   group rule): the subject's department, else one AD group. Ask the analyst for the
//   roster only if AD has no team for the subject. Never drop the team comparison silently.
//   Roster known (named in the request, supplied in a later turn, or resolved from AD) ->
//   keep the blocks, fill the cohort_filter slot with the peers ($u = "a" or $u = "b"),
//   delete only the marker lines, and swap BOTH condition: ($d_vs_team_sq >= {{fusion_threshold_sq}})
//   AND order: ($d_vs_team_sq desc). Show the filled query in the Turn 1 Pre-Flight.
//   ADDITIONAL SLOTS: entity_name = entity_var without leading $ (e.g. user or host);
//   target_entity_filter = subject/cohort filter in root stage (or {{entity_var}} != "" for fleet-wide);
//   cohort_population_guard = human USER cohort guard excluding Windows system/service and trailing-$ machine accounts;
//   m1_var_floor / m2_var_floor / m3_var_floor = 1.0 for count metrics or squared byte floor.
//   SAMUELSON SMALL-COHORT BOUND & LEAVE-ONE-OUT SCORING (PF-2 / WS1-09 / WS4-RADAR-COHORT):
//   Cohort means and variances exclude the scored entity itself ((sum_all - obs) / (N - 1)).
//   Chronicle's raw stddev() computes sample SD (N - 1 df) with the subject included in the cohort,
//   bounding max Z_i <= (N - 1) / math.sqrt(N) and D^2 <= 3 * (N - 1)^2 / N.
//   A fusion_threshold_sq of 12.25 requires team_size >= 6;
//   when $samuelson_max_d_sq < {{fusion_threshold_sq}}, $cohort_too_small = 1 ("cohort too small").
//   TRIAD COLLINEARITY & POSITIVE RECTIFICATION NOTE: Since total = fail + success, the 3 triad Z-scores
//   span 2 linearly independent degrees of freedom; negative Z-scores are rectified at 0.0 before squaring
//   (D^2 = sum(max(0, Z_m)^2)) so quiet peers never outrank surging outliers.
//   MAX JOIN COUNT BUDGET (maxJoinCount = 4): team_cohort_stats joins only all_entities (1 UEBA metrics.*
//   join + 0 in enterprise_stats + 0 in team_cohort_stats + 2 in loo_scores + 1 in Root = 4 joins).
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// Slots event_filter and m1/m2/m3_observation_agg: take them from the triad's block in
//   references/metric-sector-catalog.md "Sibling triads" (Auth, DNS, HTTP, Network bytes, Network flows).
//   The stage filter is shared by all three metrics; never paste one metric's own extra line into it.
//   Composite-only families (file_executions_*, resource_*) cannot form a triad.
// Math is upper-tail rectified (D^2 = sum of max(0, Z)^2) so quiet drops do not inflate D.
// Canonical Triad: HTTP Telemetry (Queries Total, Queries Fail, Queries Success)
//   - event_filter slot: (network.http.method != "" or network.http.user_agent != "" or network.http.response_code != 0 or network.http.referral_url != ""), entity_field slot: principal.asset.hostname, entity_var slot: $host
//   - Metric 1 (Total Queries): m1_observation_agg slot: count(metadata.id), m1_metric_func_avg slot: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
//   - Metric 2 (Failed Queries): m2_observation_agg slot: sum(if(network.http.response_code >= 400, 1, 0)), m2_metric_func_avg slot: metrics.http_queries_fail(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
//   - Metric 3 (Successful Queries): m3_observation_agg slot: sum(if(network.http.response_code < 400, 1, 0)), m3_metric_func_avg slot: metrics.http_queries_success(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
// ============================================================================

// Stage 1: Enterprise Population Telemetry + 30-Day Baselines for 3 Metrics
stage all_entities {
    {{event_filter}}
    {{entity_field}} = {{entity_var}}
    {{entity_var}} != ""
    {{cohort_population_guard}}

  match:
    {{entity_var}} by 1d

  outcome:
    $m1_obs = {{m1_observation_agg}}
    $m1_p_avg = max({{m1_metric_func_avg}})
    $m1_p_std = max({{m1_metric_func_stddev}})

    $m2_obs = {{m2_observation_agg}}
    $m2_p_avg = max({{m2_metric_func_avg}})
    $m2_p_std = max({{m2_metric_func_stddev}})

    $m3_obs = {{m3_observation_agg}}
    $m3_p_avg = max({{m3_metric_func_avg}})
    $m3_p_std = max({{m3_metric_func_stddev}})

    // In-Stage Personal Historical Z-Scores across the Triad (Outcomes-in-Outcomes)
    $m1_floor = math.sqrt(if($m1_p_avg > 1.0, $m1_p_avg, 1.0))
    $m2_floor = math.sqrt(if($m2_p_avg > 1.0, $m2_p_avg, 1.0))
    $m3_floor = math.sqrt(if($m3_p_avg > 1.0, $m3_p_avg, 1.0))
    $z1_personal = ($m1_obs - $m1_p_avg) / if($m1_p_std > $m1_floor, $m1_p_std, $m1_floor)
    $z2_personal = ($m2_obs - $m2_p_avg) / if($m2_p_std > $m2_floor, $m2_p_std, $m2_floor)
    $z3_personal = ($m3_obs - $m3_p_avg) / if($m3_p_std > $m3_floor, $m3_p_std, $m3_floor)
}

// Fleet stage: Enterprise Whole (Macro baseline across the entire fleet)
stage enterprise_stats {
    $ws = $all_entities.window_start

  match:
    $ws by 1d

  outcome:
    $m1_fleet_sum = sum($all_entities.m1_obs)
    $m1_fleet_avg = avg($all_entities.m1_obs)
    $m1_fleet_std = stddev($all_entities.m1_obs)

    $m2_fleet_sum = sum($all_entities.m2_obs)
    $m2_fleet_avg = avg($all_entities.m2_obs)
    $m2_fleet_std = stddev($all_entities.m2_obs)

    $m3_fleet_sum = sum($all_entities.m3_obs)
    $m3_fleet_avg = avg($all_entities.m3_obs)
    $m3_fleet_std = stddev($all_entities.m3_obs)

    $fleet_size = count_distinct($all_entities.{{entity_name}})
    $fleet_valid = if($fleet_size > 1, 1.0, 0.0)
    $fleet_peer_n = if($fleet_size > 1, $fleet_size, 2) - 1.0
    $fleet_n_over_nm1 = $fleet_size / $fleet_peer_n
    $fleet_inv_df = 1.0 / (if($fleet_size > 2, $fleet_size, 3) - 2.0)
    $m1_fleet_ss = $fleet_peer_n * $m1_fleet_std * $m1_fleet_std
    $m2_fleet_ss = $fleet_peer_n * $m2_fleet_std * $m2_fleet_std
    $m3_fleet_ss = $fleet_peer_n * $m3_fleet_std * $m3_fleet_std
}

// >>> TEAM COHORT
// Optional stage: Team Cohort Whole (named peers; decoupled from enterprise_stats to stay <= 4 joins)
stage team_cohort_stats {
    $u = $all_entities.{{entity_name}}
    $ws = $all_entities.window_start
    {{cohort_filter}}

  match:
    $ws by 1d

  outcome:
    $m1_team_sum = sum($all_entities.m1_obs)
    $m2_team_sum = sum($all_entities.m2_obs)
    $m3_team_sum = sum($all_entities.m3_obs)

    $m1_team_avg = avg($all_entities.m1_obs)
    $m2_team_avg = avg($all_entities.m2_obs)
    $m3_team_avg = avg($all_entities.m3_obs)

    $m1_team_std = stddev($all_entities.m1_obs)
    $m2_team_std = stddev($all_entities.m2_obs)
    $m3_team_std = stddev($all_entities.m3_obs)

    $team_size = count_distinct($all_entities.{{entity_name}})
    $team_peer_n = if($team_size > 1, $team_size, 2) - 1.0
    $team_n_over_nm1 = $team_size / $team_peer_n
    $team_inv_df = 1.0 / (if($team_size > 2, $team_size, 3) - 2.0)
    $m1_team_ss = $team_peer_n * $m1_team_std * $m1_team_std
    $m2_team_ss = $team_peer_n * $m2_team_std * $m2_team_std
    $m3_team_ss = $team_peer_n * $m3_team_std * $m3_team_std
}
// <<< TEAM COHORT

// Stage 3/4: Per-Entity Leave-One-Out Cross-Sectional Z-Scores (resets arithmetic op depth before squaring)
stage loo_scores {
    {{entity_var}} = $all_entities.{{entity_name}}
    $ws = $all_entities.window_start
    // >>> TEAM COHORT
    $ws = $team_cohort_stats.ws
    // <<< TEAM COHORT
    $ws = $enterprise_stats.ws
    {{target_entity_filter}}

  match:
    {{entity_var}}, $ws by 1d

  outcome:
    $e1_loo_avg = (max($enterprise_stats.m1_fleet_sum) - max($all_entities.m1_obs)) / max($enterprise_stats.fleet_peer_n)
    $e1_var = (max($enterprise_stats.m1_fleet_ss) - (max($enterprise_stats.fleet_n_over_nm1) * (max($all_entities.m1_obs) - max($enterprise_stats.m1_fleet_avg)) * (max($all_entities.m1_obs) - max($enterprise_stats.m1_fleet_avg)))) * max($enterprise_stats.fleet_inv_df)
    $z1_vs_enterprise = max($enterprise_stats.fleet_valid) * (max($all_entities.m1_obs) - $e1_loo_avg) / math.sqrt(if(if($e1_var > $e1_loo_avg, $e1_var, $e1_loo_avg) > {{m1_var_floor}}, if($e1_var > $e1_loo_avg, $e1_var, $e1_loo_avg), {{m1_var_floor}}))

    $e2_loo_avg = (max($enterprise_stats.m2_fleet_sum) - max($all_entities.m2_obs)) / max($enterprise_stats.fleet_peer_n)
    $e2_var = (max($enterprise_stats.m2_fleet_ss) - (max($enterprise_stats.fleet_n_over_nm1) * (max($all_entities.m2_obs) - max($enterprise_stats.m2_fleet_avg)) * (max($all_entities.m2_obs) - max($enterprise_stats.m2_fleet_avg)))) * max($enterprise_stats.fleet_inv_df)
    $z2_vs_enterprise = max($enterprise_stats.fleet_valid) * (max($all_entities.m2_obs) - $e2_loo_avg) / math.sqrt(if(if($e2_var > $e2_loo_avg, $e2_var, $e2_loo_avg) > {{m2_var_floor}}, if($e2_var > $e2_loo_avg, $e2_var, $e2_loo_avg), {{m2_var_floor}}))

    $e3_loo_avg = (max($enterprise_stats.m3_fleet_sum) - max($all_entities.m3_obs)) / max($enterprise_stats.fleet_peer_n)
    $e3_var = (max($enterprise_stats.m3_fleet_ss) - (max($enterprise_stats.fleet_n_over_nm1) * (max($all_entities.m3_obs) - max($enterprise_stats.m3_fleet_avg)) * (max($all_entities.m3_obs) - max($enterprise_stats.m3_fleet_avg)))) * max($enterprise_stats.fleet_inv_df)
    $z3_vs_enterprise = max($enterprise_stats.fleet_valid) * (max($all_entities.m3_obs) - $e3_loo_avg) / math.sqrt(if(if($e3_var > $e3_loo_avg, $e3_var, $e3_loo_avg) > {{m3_var_floor}}, if($e3_var > $e3_loo_avg, $e3_var, $e3_loo_avg), {{m3_var_floor}}))

    // >>> TEAM COHORT
    $t1_loo_avg = (max($team_cohort_stats.m1_team_sum) - max($all_entities.m1_obs)) / max($team_cohort_stats.team_peer_n)
    $t1_var = (max($team_cohort_stats.m1_team_ss) - (max($team_cohort_stats.team_n_over_nm1) * (max($all_entities.m1_obs) - max($team_cohort_stats.m1_team_avg)) * (max($all_entities.m1_obs) - max($team_cohort_stats.m1_team_avg)))) * max($team_cohort_stats.team_inv_df)
    $z1_vs_team = (max($all_entities.m1_obs) - $t1_loo_avg) / math.sqrt(if(if($t1_var > $t1_loo_avg, $t1_var, $t1_loo_avg) > {{m1_var_floor}}, if($t1_var > $t1_loo_avg, $t1_var, $t1_loo_avg), {{m1_var_floor}}))

    $t2_loo_avg = (max($team_cohort_stats.m2_team_sum) - max($all_entities.m2_obs)) / max($team_cohort_stats.team_peer_n)
    $t2_var = (max($team_cohort_stats.m2_team_ss) - (max($team_cohort_stats.team_n_over_nm1) * (max($all_entities.m2_obs) - max($team_cohort_stats.m2_team_avg)) * (max($all_entities.m2_obs) - max($team_cohort_stats.m2_team_avg)))) * max($team_cohort_stats.team_inv_df)
    $z2_vs_team = (max($all_entities.m2_obs) - $t2_loo_avg) / math.sqrt(if(if($t2_var > $t2_loo_avg, $t2_var, $t2_loo_avg) > {{m2_var_floor}}, if($t2_var > $t2_loo_avg, $t2_var, $t2_loo_avg), {{m2_var_floor}}))

    $t3_loo_avg = (max($team_cohort_stats.m3_team_sum) - max($all_entities.m3_obs)) / max($team_cohort_stats.team_peer_n)
    $t3_var = (max($team_cohort_stats.m3_team_ss) - (max($team_cohort_stats.team_n_over_nm1) * (max($all_entities.m3_obs) - max($team_cohort_stats.m3_team_avg)) * (max($all_entities.m3_obs) - max($team_cohort_stats.m3_team_avg)))) * max($team_cohort_stats.team_inv_df)
    $z3_vs_team = (max($all_entities.m3_obs) - $t3_loo_avg) / math.sqrt(if(if($t3_var > $t3_loo_avg, $t3_var, $t3_loo_avg) > {{m3_var_floor}}, if($t3_var > $t3_loo_avg, $t3_var, $t3_loo_avg), {{m3_var_floor}}))

    $team_size = max($team_cohort_stats.team_size)
    // <<< TEAM COHORT
}

// Root Stage: Positive-Rectified Multilevel Triad Scoring & Composite Distance
{{entity_var}} = $all_entities.{{entity_name}}
$ws = $all_entities.window_start
{{entity_var}} = $loo_scores.{{entity_name}}
$ws = $loo_scores.ws

{{target_entity_filter}}

match:
  {{entity_var}}, $ws by 1d

outcome:
  $m1_observed = max($all_entities.m1_obs)
  $m2_observed = max($all_entities.m2_obs)
  $m3_observed = max($all_entities.m3_obs)

  // 1. Personal Historical Z-Scores from Stage 1
  $z1_personal = max($all_entities.z1_personal)
  $z2_personal = max($all_entities.z2_personal)
  $z3_personal = max($all_entities.z3_personal)

  // >>> TEAM COHORT
  // Peer group only: Leave-One-Out Team Cross-Sectional Z-Scores ("Part of the Team")
  $team_size = max($loo_scores.team_size)
  $z1_vs_team = if($team_size > 1, max($loo_scores.z1_vs_team), 0.0)
  $z2_vs_team = if($team_size > 1, max($loo_scores.z2_vs_team), 0.0)
  $z3_vs_team = if($team_size > 1, max($loo_scores.z3_vs_team), 0.0)

  $d_vs_team_sq = (if($z1_vs_team > 0.0, $z1_vs_team, 0.0) * if($z1_vs_team > 0.0, $z1_vs_team, 0.0)) + (if($z2_vs_team > 0.0, $z2_vs_team, 0.0) * if($z2_vs_team > 0.0, $z2_vs_team, 0.0)) + (if($z3_vs_team > 0.0, $z3_vs_team, 0.0) * if($z3_vs_team > 0.0, $z3_vs_team, 0.0))

  $samuelson_max_z = ($team_size - 1.0) / math.sqrt(if($team_size > 1, $team_size, 1.0))
  $samuelson_max_d_sq = 3.0 * $samuelson_max_z * $samuelson_max_z
  $cohort_too_small = if($samuelson_max_d_sq < {{fusion_threshold_sq}}, 1, 0)
  // <<< TEAM COHORT

  // 2. Leave-One-Out Enterprise Cross-Sectional Z-Scores ("Part of the Fleet")
  $z1_vs_enterprise = max($loo_scores.z1_vs_enterprise)
  $z2_vs_enterprise = max($loo_scores.z2_vs_enterprise)
  $z3_vs_enterprise = max($loo_scores.z3_vs_enterprise)

  // 3. Positive-Rectified Composite Threat Norm Across the Triad vs the Fleet
  $d_vs_fleet_sq = (if($z1_vs_enterprise > 0.0, $z1_vs_enterprise, 0.0) * if($z1_vs_enterprise > 0.0, $z1_vs_enterprise, 0.0)) + (if($z2_vs_enterprise > 0.0, $z2_vs_enterprise, 0.0) * if($z2_vs_enterprise > 0.0, $z2_vs_enterprise, 0.0)) + (if($z3_vs_enterprise > 0.0, $z3_vs_enterprise, 0.0) * if($z3_vs_enterprise > 0.0, $z3_vs_enterprise, 0.0))

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $d_vs_fleet_sq >= {{fusion_threshold_sq}}

order:
  $d_vs_fleet_sq desc
