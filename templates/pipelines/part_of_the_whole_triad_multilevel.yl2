// ============================================================================
// ARCHITECTURE: 3-METRIC MULTILEVEL PART-OF-THE-WHOLE TRIAD DAG
// Skill: secops-risk-metrics-multistage
// Purpose: Evaluates an individual against their personal 30-day baseline and
//          the fleet (enterprise whole) across three sibling metrics within the
//          same UDM event stream; optionally also against a named peer cohort.
// Math: Multilevel Triad Z-Scores (Personal, Fleet[, Team]) + Composite D_fleet^2
//
// PEER GROUP (default = fleet only):
//   No peers mentioned -> delete every block between "// >>> TEAM COHORT" and
//   "// <<< TEAM COHORT" (3 blocks) and keep "order: $d_vs_fleet_sq desc". Without a peer
//   list the team stage would just recompute the fleet.
//   Peers mentioned but not named (e.g. "vs his team") -> resolve the team from Active
//   Directory in Turn 1 (AD TEAM LOOKUP in references/multi-stage-metrics-guide.md, Peer
//   group rule): the subject's department, else one AD group. Ask the analyst for the
//   roster only if AD has no team for the subject. Never drop the team comparison silently.
//   Roster known (named in the request, supplied in a later turn, or resolved from AD) ->
//   keep the blocks, fill the cohort_filter slot with the peers ($u = "a" or $u = "b"),
//   delete only the marker lines, and order by $d_vs_team_sq desc. Show the filled query
//   in the Turn 1 Pre-Flight.
//   Path user -> group -> enterprise: $z*_vs_team (one vs group), $z*_team_vs_enterprise and
//   $d_team_vs_fleet_sq (group mean vs fleet; elevated = team campaign/rollout).
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// Slots event_filter and m1/m2/m3_observation_agg: take them from the triad's block in
//   references/metric-sector-catalog.md "Sibling triads" (Auth, DNS, HTTP, Network bytes, Network flows).
//   The stage filter is shared by all three metrics; never paste one metric's own extra line into it.
//   Composite-only families (file_executions_*, resource_*) cannot form a triad.
// Math is two-sided (D^2 = sum of Z^2); a drop in one metric also raises D.
// Canonical Triad: HTTP Telemetry (Queries Total, Queries Fail, Queries Success)
//   - event_filter slot: (network.http.method != "" or network.http.user_agent != "" or network.http.response_code != 0 or network.http.referral_url != ""), entity_field slot: principal.asset.hostname, entity_var slot: $host
//   - Metric 1 (Total Queries): m1_observation_agg slot: count(metadata.id), m1_metric_func_avg slot: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
//   - Metric 2 (Failed Queries): m2_observation_agg slot: sum(if(network.http.response_code >= 400, 1, 0)), m2_metric_func_avg slot: metrics.http_queries_fail(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
//   - Metric 3 (Successful Queries): m3_observation_agg slot: sum(if(network.http.response_code < 400, 1, 0)), m3_metric_func_avg slot: metrics.http_queries_success(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
// ============================================================================

// Stage 1: Enterprise Population Telemetry + 30-Day Baselines for 3 Metrics
stage all_entities {
    {{event_filter}}
    {{entity_field}} = {{entity_var}}
    {{entity_var}} != ""

  match:
    {{entity_var}} by 1d

  outcome:
    $m1_obs = {{m1_observation_agg}}
    $m1_p_avg = max({{m1_metric_func_avg}})
    $m1_p_std = max({{m1_metric_func_stddev}})

    $m2_obs = {{m2_observation_agg}}
    $m2_p_avg = max({{m2_metric_func_avg}})
    $m2_p_std = max({{m2_metric_func_stddev}})

    $m3_obs = {{m3_observation_agg}}
    $m3_p_avg = max({{m3_metric_func_avg}})
    $m3_p_std = max({{m3_metric_func_stddev}})

    // In-Stage Personal Historical Z-Scores across the Triad (Outcomes-in-Outcomes)
    $z1_personal = ($m1_obs - $m1_p_avg) / if($m1_p_std > 0, $m1_p_std, 1.0)
    $z2_personal = ($m2_obs - $m2_p_avg) / if($m2_p_std > 0, $m2_p_std, 1.0)
    $z3_personal = ($m3_obs - $m3_p_avg) / if($m3_p_std > 0, $m3_p_std, 1.0)
}

// Fleet stage: Enterprise Whole (Macro baseline across the entire fleet)
stage enterprise_stats {
    $ws = $all_entities.window_start

  match:
    $ws by 1d

  outcome:
    $m1_fleet_avg = avg($all_entities.m1_obs)
    $m1_fleet_std = stddev($all_entities.m1_obs)

    $m2_fleet_avg = avg($all_entities.m2_obs)
    $m2_fleet_std = stddev($all_entities.m2_obs)

    $m3_fleet_avg = avg($all_entities.m3_obs)
    $m3_fleet_std = stddev($all_entities.m3_obs)

    // Zero-safe divisors (keeps the root under the 20-outcome limit)
    $m1_fleet_div = if($m1_fleet_std > 0, $m1_fleet_std, 1.0)
    $m2_fleet_div = if($m2_fleet_std > 0, $m2_fleet_std, 1.0)
    $m3_fleet_div = if($m3_fleet_std > 0, $m3_fleet_std, 1.0)

    $fleet_size = count_distinct($all_entities.{{entity_name}})
}

// >>> TEAM COHORT
// Optional stage: Team Cohort Whole (named peers) + the group as a whole vs the fleet
stage team_cohort_stats {
    $u = $all_entities.{{entity_name}}
    $ws = $all_entities.window_start
    $ws = $enterprise_stats.ws
    {{cohort_filter}}

  match:
    $ws by 1d

  outcome:
    $m1_team_avg = avg($all_entities.m1_obs)
    $m2_team_avg = avg($all_entities.m2_obs)
    $m3_team_avg = avg($all_entities.m3_obs)

    $m1_team_std = stddev($all_entities.m1_obs)
    $m2_team_std = stddev($all_entities.m2_obs)
    $m3_team_std = stddev($all_entities.m3_obs)
    $m1_team_div = if($m1_team_std > 0, $m1_team_std, 1.0)
    $m2_team_div = if($m2_team_std > 0, $m2_team_std, 1.0)
    $m3_team_div = if($m3_team_std > 0, $m3_team_std, 1.0)

    // Group vs Enterprise ("Team as Part of the Fleet"): team mean in fleet std units
    $z1_team_vs_enterprise = ($m1_team_avg - max($enterprise_stats.m1_fleet_avg)) / max($enterprise_stats.m1_fleet_div)
    $z2_team_vs_enterprise = ($m2_team_avg - max($enterprise_stats.m2_fleet_avg)) / max($enterprise_stats.m2_fleet_div)
    $z3_team_vs_enterprise = ($m3_team_avg - max($enterprise_stats.m3_fleet_avg)) / max($enterprise_stats.m3_fleet_div)
    $d_team_vs_fleet_sq = ($z1_team_vs_enterprise * $z1_team_vs_enterprise) + ($z2_team_vs_enterprise * $z2_team_vs_enterprise) + ($z3_team_vs_enterprise * $z3_team_vs_enterprise)

    $team_size = count_distinct($all_entities.{{entity_name}})
}
// <<< TEAM COHORT

// Root Stage: Multilevel Triad Scoring & Composite Distance
{{entity_var}} = $all_entities.{{entity_name}}
$ws = $all_entities.window_start
// >>> TEAM COHORT
$ws = $team_cohort_stats.ws
// <<< TEAM COHORT
$ws = $enterprise_stats.ws

{{target_entity_filter}}

match:
  {{entity_var}}, $ws by 1d

outcome:
  $m1_observed = max($all_entities.m1_obs)
  $m2_observed = max($all_entities.m2_obs)
  $m3_observed = max($all_entities.m3_obs)

  // 1. Personal Historical Z-Scores from Stage 1
  $z1_personal = max($all_entities.z1_personal)
  $z2_personal = max($all_entities.z2_personal)
  $z3_personal = max($all_entities.z3_personal)

  // >>> TEAM COHORT
  // Peer group only: Team Cross-Sectional Z-Scores ("Part of the Team")
  $z1_vs_team = ($m1_observed - max($team_cohort_stats.m1_team_avg)) / max($team_cohort_stats.m1_team_div)
  $z2_vs_team = ($m2_observed - max($team_cohort_stats.m2_team_avg)) / max($team_cohort_stats.m2_team_div)
  $z3_vs_team = ($m3_observed - max($team_cohort_stats.m3_team_avg)) / max($team_cohort_stats.m3_team_div)

  $d_vs_team_sq = ($z1_vs_team * $z1_vs_team) + ($z2_vs_team * $z2_vs_team) + ($z3_vs_team * $z3_vs_team)

  // 4. Group vs Enterprise, computed in team_cohort_stats (elevated = team campaign/rollout)
  $d_team_vs_fleet_sq = max($team_cohort_stats.d_team_vs_fleet_sq)
  $team_size = max($team_cohort_stats.team_size)
  // <<< TEAM COHORT

  // 2. Enterprise Cross-Sectional Z-Scores ("Part of the Fleet")
  $z1_vs_enterprise = ($m1_observed - max($enterprise_stats.m1_fleet_avg)) / max($enterprise_stats.m1_fleet_div)
  $z2_vs_enterprise = ($m2_observed - max($enterprise_stats.m2_fleet_avg)) / max($enterprise_stats.m2_fleet_div)
  $z3_vs_enterprise = ($m3_observed - max($enterprise_stats.m3_fleet_avg)) / max($enterprise_stats.m3_fleet_div)

  // 3. Composite Threat Norm Across the Triad vs the Fleet
  $d_vs_fleet_sq = ($z1_vs_enterprise * $z1_vs_enterprise) + ($z2_vs_enterprise * $z2_vs_enterprise) + ($z3_vs_enterprise * $z3_vs_enterprise)

order:
  $d_vs_fleet_sq desc
