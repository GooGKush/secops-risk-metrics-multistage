// ============================================================================
// ARCHITECTURE: 3-STAGE NON-PARAMETRIC QUANTILES, BOWLEY SKEWNESS & SKEW-ADJUSTED TUKEY FENCE
// Skill: secops-risk-metrics-multistage
// Purpose: 1-stage non-parametric quantile envelope ($p10, $q25, $q50, $q75, $p90), Bowley quartile
//          skewness ($bowley_skew), Moors tail-heaviness ratio ($tail_heaviness), and Hubert-Vandervieren
//          Skewness-Adjusted Tukey Upper Fence ($adj_upper_fence) side by side with pre-scoring raw active-day Z.
// Stages: stage1_extract (event stage, daily observed + pre-scoring accumulators + 1 metrics.* provenance lookup)
//         -> quantile_envelope (5-point window.percentile envelope + pre-scoring stats in 1 stage!) -> root (scores)
// Stage-Budget Advantage: Saves 1 full stage & 1 join compared to 4-stage MAD, leaving room to attach
//                         an Entity Context Graph (DERIVED_CONTEXT / GLOBAL_CONTEXT) or peer-cohort stage.
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// Slots event_filter / macro_event_filter: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// 1. Network Outbound Bytes (Host):
//    - event_filter slot: network.sent_bytes > 0 AND network.sent_bytes < 1000000000000000 (network_bytes_outbound), entity_field slot: principal.asset.hostname
//    - observed_aggregation slot: sum(network.sent_bytes), target_metric_name slot: network_bytes_outbound
//    - metric_type_val slot: value_sum, dimension_key slot: principal.asset.hostname
// 2. Authentication Attempts (User):
//    - event_filter slot: metadata.event_type = "USER_LOGIN", entity_field slot: target.user.userid
//    - observed_aggregation slot: count(metadata.id), target_metric_name slot: auth_attempts_total
//    - metric_type_val slot: event_count_sum, dimension_key slot: target.user.userid
// ============================================================================

// Stage 1: Telemetry Extraction, Pre-Scoring Raw Accumulators & Lightweight Metrics Provenance Lookup
stage stage1_extract {
    {{event_filter}}
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $observed_val = {{observed_aggregation}}
    $in_scoring_window = max(if(timestamp.get_date(metadata.event_timestamp.seconds) >= "{{first_scored_date}}", 1, 0))
    $obs_float = 1.0 * $observed_val
    $pre_obs = if($in_scoring_window = 0, $obs_float, 0.0)
    $pre_obs_sq = $pre_obs * $pre_obs
    $pre_day = if($in_scoring_window = 0, 1, 0)
    $observed_events = count(metadata.id)

    $historical_active_days = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: num_metric_periods,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
}

// Stage 2: 1-Stage 5-Point Empirical Quantile Envelope & Pre-Scoring Sample Statistics
stage quantile_envelope {
    $entity = $stage1_extract.entity

  match:
    $entity

  outcome:
    $p10 = window.percentile($stage1_extract.observed_val, 10)
    $q25 = window.percentile($stage1_extract.observed_val, 25)
    $q50 = window.percentile($stage1_extract.observed_val, 50)
    $q75 = window.percentile($stage1_extract.observed_val, 75)
    $p90 = window.percentile($stage1_extract.observed_val, 90)
    $raw_active_days = count_distinct($stage1_extract.window_start)
    $pre_n = sum($stage1_extract.pre_day)
    $pre_sum = sum($stage1_extract.pre_obs)
    $pre_sum_sq = sum($stage1_extract.pre_obs_sq)
    $historical_active_days = max($stage1_extract.historical_active_days)
    $safe_pre_n = if($pre_n > 0, $pre_n, 1.0)
    $pre_avg = $pre_sum / $safe_pre_n
    $pre_df_raw = $pre_n - 1.0
    $safe_pre_df = if($pre_n > 1, $pre_df_raw, 1.0)
    $raw_var_num = $pre_sum_sq - ($pre_n * $pre_avg * $pre_avg)
    $pre_sd = math.sqrt(if($raw_var_num > 0, $raw_var_num, 0.0) / $safe_pre_df)
    $dispersion_floor = math.sqrt(if($pre_avg > 1.0, $pre_avg, 1.0))
    $safe_pre_sd = if($pre_sd > $dispersion_floor, $pre_sd, $dispersion_floor)
}

// Root Stage: Skewness-Adjusted Tukey Fence & Bowley Asymmetry vs Pre-Scoring Classical Z
$entity = $stage1_extract.entity
$entity = $quantile_envelope.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_avg = max($quantile_envelope.pre_avg)
  $hist_stddev = max($quantile_envelope.pre_sd)
  $active_days = max($quantile_envelope.pre_n)
  $q25_val = max($quantile_envelope.q25)
  $q50_val = max($quantile_envelope.q50)
  $q75_val = max($quantile_envelope.q75)
  $raw_active_days = max($quantile_envelope.raw_active_days)
  $in_scoring_window = max($stage1_extract.in_scoring_window)

  // 1. Pre-scoring raw active-day Z (cross-check without [D0-59d, D0-29d) stale-anchor shift)
  $safe_stddev = max($quantile_envelope.safe_pre_sd)
  $raw_personal_z = ($observed - $hist_avg) / $safe_stddev
  $personal_z = if($active_days >= {{min_baseline_days}}, $raw_personal_z, 0.0)

  // 2. Non-Parametric IQR, Bowley Quartile Skewness & Tail-Heaviness Ratio
  $iqr = $q75_val - $q25_val
  $q50_floor = $q50_val * 0.05 + 1.0
  $safe_iqr = if($iqr > 0, $iqr, $q50_floor)
  $bowley_skew = ($q75_val + $q25_val - (2.0 * $q50_val)) / $safe_iqr
  $tail_heaviness = (max($quantile_envelope.p90) - max($quantile_envelope.p10)) / $safe_iqr

  // 3. Hubert-Vandervieren Skewness-Adjusted Tukey Upper Fence (Bowley 1.35) & Robust Scale-Excess
  $adj_upper_fence = $q75_val + (1.5 * math.pow(2.718281828, 1.35 * if($bowley_skew > 0, $bowley_skew, 0.0)) * $safe_iqr)
  $robust_scale = $safe_iqr / 1.349
  $tukey_excess_z = ($observed - $adj_upper_fence) / $robust_scale

condition:
  $in_scoring_window = 1 and $raw_active_days >= {{min_baseline_days}} and $tukey_excess_z >= {{tukey_excess_threshold}}

order:
  $tukey_excess_z desc
