// ============================================================================
// ARCHITECTURE: 3-STAGE DUAL-BASELINE POPULATION NORMALIZATION (DELTA-Z)
// Skill: secops-risk-metrics-multistage
// Purpose: Isolates targeted endpoint anomalies from company-wide surges (Patch Tuesday immunity)
// Math: Delta-Z = Z_Personal - Z_Fleet_Today
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// 1. Process Launch Volumetric Delta-Z:
//    - {{event_type}}: "PROCESS_LAUNCH"
//    - {{target_metric_func_avg}}: metrics.file_executions_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, metadata.event_type: "PROCESS_LAUNCH", principal.asset.hostname: $host, principal.process.file.sha256: $sha)
//    - {{target_metric_func_stddev}}: metrics.file_executions_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, metadata.event_type: "PROCESS_LAUNCH", principal.asset.hostname: $host, principal.process.file.sha256: $sha)
//    - {{target_metric_func_active_days}}: metrics.file_executions_total(period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods, metadata.event_type: "PROCESS_LAUNCH", principal.asset.hostname: $host, principal.process.file.sha256: $sha)
// 2. Network Outbound Bytes Delta-Z:
//    - {{event_type}}: "NETWORK_CONNECTION"
//    - {{target_metric_func_avg}}: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: avg, principal.asset.hostname: $host)
//    - {{target_metric_func_stddev}}: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: stddev, principal.asset.hostname: $host)
//    - {{target_metric_func_active_days}}: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: num_metric_periods, principal.asset.hostname: $host)
// ============================================================================

// Stage 1: Individual Host Daily Metric Extraction + 30-Day Historical Baseline
stage host_extract {
    metadata.event_type = "{{event_type}}"
    principal.asset.hostname = $host
    $host != ""

  match:
    $host by 1d

  outcome:
    $observed_24h = count(metadata.id)
    $hist_avg = max({{target_metric_func_avg}})
    $hist_stddev = max({{target_metric_func_stddev}})
    $hist_active_days = max({{target_metric_func_active_days}})

    // In-Stage Personal Historical Z-Score (Outcomes-in-Outcomes)
    $personal_diff = $observed_24h - $hist_avg
    $personal_z = $personal_diff / ($hist_stddev + 1.0)
}

// Stage 2: Concurrent Fleet-Wide Macro Baseline across all active endpoints today
stage fleet_stats {
    $host = $host_extract.host
    $ws = $host_extract.window_start

  match:
    $ws by 1d

  outcome:
    $fleet_today_avg = avg($host_extract.observed_24h)
    $fleet_today_stddev = stddev($host_extract.observed_24h)
    $active_fleet_hosts = count_distinct($host_extract.host)
}

// Stage 3 (Root Stage): Dual-Baseline Delta-Z Evaluation
$host = $host_extract.host
$ws = $host_extract.window_start
$ws = $fleet_stats.ws

match:
  $host, $ws by 1d

outcome:
  $obs = max($host_extract.observed_24h)
  $personal_z = max($host_extract.personal_z)
  $active_days = max($host_extract.hist_active_days)
  
  $fleet_avg = max($fleet_stats.fleet_today_avg)
  $fleet_stddev = max($fleet_stats.fleet_today_stddev)
  $fleet_size = max($fleet_stats.active_fleet_hosts)

  // 1. Fleet Today Cross-Sectional Z-Score
  $fleet_diff = $obs - $fleet_avg
  $fleet_z = $fleet_diff / ($fleet_stddev + 1.0)

  // 3. Delta-Z Anomaly Isolation (Targeted anomaly score)
  $delta_z = $personal_z - $fleet_z

order:
  $delta_z desc
