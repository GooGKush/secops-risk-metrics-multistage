// ============================================================================
// ARCHITECTURE: 3-STAGE DUAL-BASELINE POPULATION NORMALIZATION (DELTA-Z)
// Skill: secops-risk-metrics-multistage
// Purpose: Isolates targeted endpoint anomalies from company-wide surges (Patch Tuesday immunity)
// Math: Delta-Z = Z_Personal - Z_Fleet_Today
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// entity_field slot: the entity key (default principal.asset.hostname); observed_agg slot: the metric's "Observed value".
// Slots event_filter / macro_event_filter: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// 1. HTTP Query Volumetric Delta-Z (Single-Key Host):
//    - event_filter slot: (network.http.method != "" or network.http.user_agent != "" or network.http.response_code != 0 or network.http.referral_url != "")
//    - target_metric_func_avg slot: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
//    - target_metric_func_stddev slot: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, principal.asset.hostname: principal.asset.hostname)
//    - target_metric_func_active_days slot: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods, principal.asset.hostname: principal.asset.hostname)
// 2. Network Outbound Bytes Delta-Z:
//    - event_filter slot: network.sent_bytes > 0 AND network.sent_bytes < 1000000000000000 (network_bytes_outbound)
//    - target_metric_func_avg slot: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
//    - target_metric_func_stddev slot: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: stddev, principal.asset.hostname: principal.asset.hostname)
//    - target_metric_func_active_days slot: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: num_metric_periods, principal.asset.hostname: principal.asset.hostname)
// ============================================================================

// Stage 1: Individual Host Daily Metric Extraction + 30-Day Historical Baseline
stage host_extract {
    {{event_filter}}
    {{entity_field}} = $host
    $host != ""

  match:
    $host by 1d

  outcome:
    $observed_24h = {{observed_agg}}
    $hist_avg = max({{target_metric_func_avg}})
    $hist_stddev = max({{target_metric_func_stddev}})
    $hist_active_days = max({{target_metric_func_active_days}})

    // In-Stage Personal Historical Z-Score (Outcomes-in-Outcomes)
    $dispersion_floor = math.sqrt(if($hist_avg > 1.0, $hist_avg, 1.0))
    $personal_z = ($observed_24h - $hist_avg) / if($hist_stddev > $dispersion_floor, $hist_stddev, $dispersion_floor)
}

// Stage 2: Concurrent Fleet-Wide Macro Baseline across mature active endpoints today
stage fleet_stats {
    $host = $host_extract.host
    $ws = $host_extract.window_start
    $host_extract.hist_active_days >= {{min_baseline_days}}

  match:
    $ws by 1d

  outcome:
    $fleet_today_avg = avg($host_extract.observed_24h)
    $fleet_today_stddev = stddev($host_extract.observed_24h)
    $fleet_z_avg = avg($host_extract.personal_z)
    $active_fleet_hosts = count_distinct($host_extract.host)
}

// Stage 3 (Root Stage): Dual-Baseline Delta-Z Evaluation
$host = $host_extract.host
$ws = $host_extract.window_start
$ws = $fleet_stats.ws

match:
  $host, $ws by 1d

outcome:
  $obs = max($host_extract.observed_24h)
  $personal_z = max($host_extract.personal_z)
  $active_days = max($host_extract.hist_active_days)
  
  $fleet_avg = max($fleet_stats.fleet_today_avg)
  $fleet_stddev = max($fleet_stats.fleet_today_stddev)
  $fleet_size = max($fleet_stats.active_fleet_hosts)

  // 1. Fleet Today Cross-Sectional Volume Z-Score & Common-Unit Fleet Mean Personal Z
  $raw_fleet_z = ($obs - $fleet_avg) / if($fleet_stddev > 0, $fleet_stddev, 1.0)
  $fleet_z = max($fleet_stats.fleet_z_avg)

  // 3. Delta-Z Anomaly Isolation in common within-entity sigma units (Targeted anomaly score)
  $delta_z = $personal_z - $fleet_z

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $delta_z >= {{anomaly_threshold}} and $active_days >= {{min_baseline_days}}

order:
  $delta_z desc
