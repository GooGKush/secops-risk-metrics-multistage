// ============================================================================
// ARCHITECTURE: 2-STAGE DUAL-BRANCH CLOUD REPOSITORY SCOPE & ORIGIN OUTLIER PIPELINE
// Skill: secops-risk-metrics-multistage
// Purpose: Detects service accounts accessing cloud data stores out of normal scope or from unexpected host origins
// Methodology: Local-Baseline Isolation (Solves Elephant & Mouse Problem)
// Branches:
//   1. Depth Outlier: Volumetric surge in high-traffic known destinations (Obs >> mu_dest)
//   2. Breadth Outlier: Zero-baseline acute departure on novel data repositories (dest_active_days == 0)
//   3. Origin Outlier: Zero-baseline novel host IP or anomalous volume from caller origin (origin_active_days == 0)
// Join Accounting: 1 UEBA Metric Join + 0 Root Stage Joins = 1 Join Total (Limit: <= 4)
// ============================================================================

// --- STAGE 1: Dynamic Cloud Repository Extraction & Pre-Computed Baseline Lookups ---
stage stage1_extract {
    metadata.event_type = "RESOURCE_READ"
    $sa = principal.user.userid
    $vendor = metadata.vendor_name
    $product = metadata.product_name
    $resource = target.resource.name
    $ip = principal.ip

    // Enforce cloud service account identity construction (GCP *.gserviceaccount.com or AWS IAM role ARN)
    (
        $sa = /@.*gserviceaccount\.com$/ nocase or
        $sa = /^arn:aws:(iam|sts)::.*:(role|assumed-role)\// nocase
    )
    $resource != ""

  match:
    $sa, $vendor, $product, $resource, $ip by 1d

  outcome:
    $observed_reads = count(metadata.id)

    // 1. Destination Resource Baseline (Local-Baseline Isolation)
    $dest_avg = max(metrics.resource_read_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    $dest_stddev = max(metrics.resource_read_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    // 1b. Destination Resource Write Baseline (Mandatory Companion Isolation)
    $dest_write_avg = max(metrics.resource_written_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    $dest_write_stddev = max(metrics.resource_written_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    $dest_del_avg = max(metrics.resource_deletion_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    $dest_del_stddev = max(metrics.resource_deletion_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    $dest_active_days = max(metrics.resource_read_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))

    // 2. Caller Origin IP Baseline
    $origin_avg = max(metrics.resource_read_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.user.userid: $sa,
        principal.ip: $ip,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product
    ))
    $origin_stddev = max(metrics.resource_read_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.user.userid: $sa,
        principal.ip: $ip,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product
    ))
    $origin_active_days = max(metrics.resource_read_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.user.userid: $sa,
        principal.ip: $ip,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product
    ))

    // In-Stage Local-Baseline Isolation (Outcomes-in-Outcomes)
    // 1. Destination Resource Outlier Scores (Read, Write, Deletion)
    $safe_dest_std = if($dest_stddev > 0, $dest_stddev, 1.0)
    $dest_z = ($observed_reads - $dest_avg) / $safe_dest_std

    $safe_write_std = if($dest_write_stddev > 0, $dest_write_stddev, 1.0)
    $write_z = ($observed_reads - $dest_write_avg) / $safe_write_std

    $safe_del_std = if($dest_del_stddev > 0, $dest_del_stddev, 1.0)
    $del_z = ($observed_reads - $dest_del_avg) / $safe_del_std

    // 2. Caller Origin IP Outlier Score
    $safe_origin_std = if($origin_stddev > 0, $origin_stddev, 1.0)
    $origin_z = ($observed_reads - $origin_avg) / $safe_origin_std

    // 3. Composite Dual-Branch Threat Score
    $composite_risk = $dest_z + $origin_z
}

// --- ROOT STAGE: Dual-Branch Evaluation & Composite Risk Ranking ---
$sa = $stage1_extract.sa
$product = $stage1_extract.product
$resource = $stage1_extract.resource
$ip = $stage1_extract.ip
$ws = $stage1_extract.window_start

match:
  $sa, $product, $resource, $ip, $ws by 1d

outcome:
  $obs = max($stage1_extract.observed_reads)
  $dest_days = max($stage1_extract.dest_active_days)
  $origin_days = max($stage1_extract.origin_active_days)

  // Fused Outlier Scores from Stage 1
  $dest_z = max($stage1_extract.dest_z)
  $write_z = max($stage1_extract.write_z)
  $del_z = max($stage1_extract.del_z)
  $origin_z = max($stage1_extract.origin_z)
  $composite_risk = max($stage1_extract.composite_risk)

order:
  $composite_risk desc
