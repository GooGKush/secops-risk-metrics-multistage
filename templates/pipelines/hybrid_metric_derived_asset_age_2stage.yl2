// ============================================================================
// ARCHITECTURE: 2-STAGE DUAL-PLANE DERIVED CONTEXT ASSET AGE PIPELINE
// Skill: secops-risk-metrics-multistage
// Purpose: Fuses 30-day host activity volumetric baseline (metrics.auth_attempts_total,
//          metrics.auth_attempts_fail, or metrics.network_bytes_outbound) with
//          Chronicle Entity Context Graph (DERIVED_CONTEXT) asset first-seen age
//          to isolate infant assets (<= 7 days old) exhibiting immediate anomalous behavior.
// Join Budget: 1 metric lookup (Stage 1) + 1 stage join (Root) = 2 joins total (<= 4).
// Invariant: Stage 1 evaluates universal volume; Stage 2 isolates graph lookup (ECG_LIMIT = 1).
//
// ENTITY GRAPH FRESHNESS (references/entity-context-graph-guide.md, Rule 5):
//   Daily graph records (every prevalence.* filter) are built once a day and lag about a
//   day; a window starting today 00:00Z overlaps none of them, the inner join drops every
//   row, and zero rows are structural, not a true negative. Start the search window two
//   days back at 00:00Z; the today_start_epoch slot (epoch of today 00:00Z) keeps the event
//   stage on the analysis day. The graph stage matches by key only (no time predicate).
//   Zero rows from a window starting today is a freshness gap: rerun, do not report clean.
// FILTER ONLY: the graph stage is an inner join. Entities with no graph record drop out
//   (absent from the graph is not the same as rare); say so in the report.
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// Slots event_filter / macro_event_filter: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// 1. Host Authentication Volume vs. Asset Age:
//    - event_filter slot: metadata.event_type = "USER_LOGIN"
//    - observed_agg slot: count(metadata.id)
//    - target_metric_func_avg slot: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: $host)
//    - target_metric_func_stddev slot: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, principal.asset.hostname: $host)
//    - target_metric_func_active_days slot: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods, principal.asset.hostname: $host)
// 2. Host Network Egress Volume vs. Asset Age:
//    - event_filter slot: network.sent_bytes > 0 AND network.sent_bytes < 1000000000000000 (network_bytes_outbound)
//    - observed_agg slot: sum(network.sent_bytes)
//    - target_metric_func_avg slot: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: avg, principal.asset.hostname: $host)
//    - target_metric_func_stddev slot: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: stddev, principal.asset.hostname: $host)
//    - target_metric_func_active_days slot: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: num_metric_periods, principal.asset.hostname: $host)
// ============================================================================

// Stage 1: Macro 30-Day Host Baseline (metrics.*)
stage stage1_asset_baseline {
    {{event_filter}}
    metadata.event_timestamp.seconds >= {{today_start_epoch}}
    principal.asset.hostname = $host
    $host != ""

  match:
    $host by 1d

  outcome:
    $observed_val = {{observed_agg}}

    $hist_mean = max({{target_metric_func_avg}})
    $hist_stddev = max({{target_metric_func_stddev}})
    $hist_active_days = max({{target_metric_func_active_days}})
    $event_timestamp = max(metadata.event_timestamp.seconds)
}

// Stage 2: Chronicle Derived Context Graph Lookup (Asset First Seen)
stage stage2_asset_derived_context {
    $asset.graph.metadata.source_type = "DERIVED_CONTEXT"
    $asset.graph.metadata.entity_type = "ASSET"
    $asset.graph.entity.asset.hostname = $host
    $host != ""

  match:
    $host

  outcome:
    $first_seen_ts = min($asset.graph.entity.asset.first_seen_time.seconds)
}

// Stage 3 (Root Stage): Fuses Host Anomaly Z-Score with Infant Asset Age Coloring
$host = $stage1_asset_baseline.host
$host = $stage2_asset_derived_context.host

match:
  $host by 1d

outcome:
  $observed = max($stage1_asset_baseline.observed_val)
  $mean = max($stage1_asset_baseline.hist_mean)
  $stddev = max($stage1_asset_baseline.hist_stddev)
  $z_score = ($observed - $mean) / if($stddev > 0, $stddev, 1.0)
  $active_baseline_days = max($stage1_asset_baseline.hist_active_days)

  $first_seen = min($stage2_asset_derived_context.first_seen_ts)
  $obs_ts = max($stage1_asset_baseline.event_timestamp)
  $asset_age_days = ($obs_ts - $first_seen) / 86400.0

  // Infant Asset Multiplier: 2.5x threat score boost for machines first seen <= 7 days ago
  $is_infant_asset = if($asset_age_days <= 7.0 and $asset_age_days >= 0.0, 1.0, 0.0)
  $threat_multiplier = if($is_infant_asset = 1.0, 2.5, 1.0)
  $threat_score = $z_score * $threat_multiplier

condition:
  $z_score >= {{anomaly_threshold}}
  and $asset_age_days <= {{max_asset_age_days}}

order:
  $threat_score desc
