// ============================================================================
// ARCHITECTURE: 2-STAGE DUAL-PLANE FLEET PREVALENCE NORMALIZATION PIPELINE
// Skill: secops-risk-metrics-multistage
// Common Compiler Conformance: YARA-L 2.0 Multi-Stage DAG Engine
// Models Supported:
//   6. Cross-Sectional Odds Ratio (Corporate Rollout Shield / Patch Tuesday Filter)
// Join Budget: 1 metric lookup (Stage 1) + 1 stage join (Root) = 2 joins total (<= 4).
// Match Topology: Token-centric match key ($token by 1d) joining personal anomaly to fleet breadth.
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// 1. Process / Binary Execution Surge (Patch Tuesday Shield for Unfamiliar Binaries):
//    - {{macro_event_type}}: "PROCESS_LAUNCH"
//    - {{macro_entity_field}}: principal.asset.hostname (or principal.user.userid)
//    - {{macro_token_field}}: principal.process.file.sha256 (CRITICAL: NEVER target.process.file.sha256)
//    - {{macro_observed_agg}}: count(metadata.id)
//    - {{target_metric_func_avg}}: metrics.file_executions_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, metadata.event_type: $event_type, principal.asset.hostname: $entity, principal.process.file.sha256: $token)
//    - {{target_metric_func_stddev}}: metrics.file_executions_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, metadata.event_type: $event_type, principal.asset.hostname: $entity, principal.process.file.sha256: $token)
//    - {{target_metric_func_active_days}}: metrics.file_executions_total(period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods, metadata.event_type: $event_type, principal.asset.hostname: $entity, principal.process.file.sha256: $token)
//    - {{raw_event_type}}: "PROCESS_LAUNCH"
//    - {{raw_token_field}}: principal.process.file.sha256
//    - {{fleet_entity_field}}: principal.asset.hostname
//
// 2. HTTP User-Agent Adoption Surge:
//    - {{macro_event_type}}: "NETWORK_HTTP"
//    - {{macro_entity_field}}: principal.asset.hostname (or principal.user.userid)
//    - {{macro_token_field}}: network.http.user_agent
//    - {{macro_observed_agg}}: count(metadata.id)
//    - {{target_metric_func_avg}}: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: $entity, network.http.user_agent: $token)
//    - {{target_metric_func_stddev}}: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, principal.asset.hostname: $entity, network.http.user_agent: $token)
//    - {{target_metric_func_active_days}}: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods, principal.asset.hostname: $entity, network.http.user_agent: $token)
//    - {{raw_event_type}}: "NETWORK_HTTP"
//    - {{raw_token_field}}: network.http.user_agent
//    - {{fleet_entity_field}}: principal.asset.hostname
// ============================================================================

// Stage 1: Individual Entity Baseline Surge & Micro-Token Extraction (metrics.*)
stage stage1_personal_surge {
    metadata.event_type = "{{macro_event_type}}"
    $event_type = metadata.event_type
    {{macro_entity_field}} = $entity
    $entity != ""
    {{macro_token_field}} = $token
    $token != ""
    {{macro_event_filter}}

  match:
    $entity, $token by 1d

  outcome:
    $observed_val = {{macro_observed_agg}}
    // NOTE: metrics.file_executions_* requires metadata.event_type: $event_type for Chronicle SIEM
    $hist_mean = max({{target_metric_func_avg}})
    $hist_stddev = max({{target_metric_func_stddev}})
    $hist_active_days = max({{target_metric_func_active_days}})

    $diff = $observed_val - $hist_mean
    $denom = $hist_stddev + 1.0
    $personal_z = $diff / $denom
    $surging_entity = array_distinct($entity)
}

// Stage 2: Enterprise-Wide Concurrent Fleet Adoption on Micro-Token (UDM_EVENTS with Entity Graph DERIVED_CONTEXT Rarity)
stage stage2_fleet_prevalence {
    metadata.event_type = "{{raw_event_type}}"
    {{raw_token_field}} = $token
    $token != ""
    {{raw_event_filter}}

    // Entity Graph Derived Context Rarity (Prevalence lookback day_count = 10 platform invariant)
    $graph.graph.metadata.entity_type = "FILE"
    $graph.graph.metadata.source_type = "DERIVED_CONTEXT"
    $graph.graph.entity.file.sha256 = $token
    $graph.graph.entity.file.prevalence.day_count = 10
    $graph.graph.entity.file.prevalence.rolling_max <= 3
    $graph.graph.entity.file.prevalence.rolling_max > 0

  match:
    $token by 1d

  outcome:
    $fleet_adopters = count_distinct({{fleet_entity_field}})
    $total_fleet_events = count(metadata.id)
    $sample_fleet_hosts = array_distinct({{fleet_entity_field}})
    $fleet_prevalence = max($graph.graph.entity.file.prevalence.rolling_max)
}

// Stage 3 (Root Stage): Common Compiler Prevalence Normalization
$token = $stage1_personal_surge.token
$token = $stage2_fleet_prevalence.token

match:
  $token by 1d

outcome:
  // Non-match string fields must use array_distinct() or count_distinct() (max/min reject strings).
  // Match variables ($token) are already preserved as primary row keys.
  $affected_hosts = array_distinct($stage1_personal_surge.surging_entity)
  $personal_z = max($stage1_personal_surge.personal_z)
  $active_baseline_days = max($stage1_personal_surge.hist_active_days)

  $fleet_adopters = max($stage2_fleet_prevalence.fleet_adopters)
  $total_events = max($stage2_fleet_prevalence.total_fleet_events)
  $fleet_prevalence = max($stage2_fleet_prevalence.fleet_prevalence)

  // Linear Prevalence Dampening Factor: 1.0 / (k_fleet + 1.0)
  // If 500 hosts adopt the hash today, dampener collapses to ~0.002
  // If only 1 host executed the hash, dampener remains 0.5 (full anomaly weight preserved)
  $prevalence_dampener = 1.0 / ($fleet_adopters + 1.0)

  // Normalized Outlier Odds: Personal Z-score dampened by fleet prevalence
  $normalized_odds_score = $personal_z * $prevalence_dampener

condition:
  // Personal host must breach historical baseline
  $personal_z >= {{personal_threshold}}
  and $active_baseline_days >= {{min_baseline_days}}
  // Fleet Prevalence Filter: Binary/token must NOT be an enterprise-wide rollout
  and $fleet_adopters <= {{max_fleet_adopters}}

order:
  $normalized_odds_score desc
