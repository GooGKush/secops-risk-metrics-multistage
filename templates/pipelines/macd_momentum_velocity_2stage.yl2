// ============================================================================
// ARCHITECTURE: 2-STAGE ABOVE-HISTORICAL-MAX Z PIPELINE (FORMERLY MACD MOMENTUM VELOCITY)
// Skill: secops-risk-metrics-multistage
// Purpose: Detects linear peak exceedance where today's volume breaks out above the 30-day historical ceiling
// Formula: personal_z = (obs - avg) / safe_stddev; above_max_z = max(0, obs - hist_max) / safe_stddev; macd_z = personal_z + above_max_z
// event_filter slot: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// Telemetry Metric Mappings:
//   - Network Bytes (Outbound): metrics.network_bytes_outbound (metric: value_sum, obs: sum(network.sent_bytes))
//   - Authentication Attempts: metrics.auth_attempts_total (metric: event_count_sum, obs: count(metadata.id))
//   - DNS Query Volume: metrics.dns_queries_total (metric: event_count_sum, obs: count(metadata.id))
// ============================================================================

// Stage 1: Daily Standardized Deviation Tracker & Baseline Metric Extraction
stage stage1_extract {
    {{event_filter}}
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $observed_val = {{observed_aggregation}}
    $observed_events = count(metadata.id)

    $historical_avg = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: avg,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_stddev = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: stddev,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_active_days = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: num_metric_periods,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_max = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: max,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_sum = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: sum,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
}

// Stage 2 (Root Stage): Above-Historical-Max Z (Linear Peak Exceedance — D1 / WS3-D1)
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_avg = max($stage1_extract.historical_avg)
  $hist_stddev = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)
  $hist_max = max($stage1_extract.historical_max)

  // 1. Personal Standardized Z-Score (Current 24h vs 30d Mean)
  $personal_diff = $observed - $hist_avg
  $dispersion_floor = math.sqrt(if($hist_avg > 1.0, $hist_avg, 1.0))
  $safe_stddev = if($hist_stddev > $dispersion_floor, $hist_stddev, $dispersion_floor)
  $personal_z = $personal_diff / $safe_stddev

  // 2. Linear Above-Historical-Max Z (ReLU exceedance above 30d historical peak; zero quadratic overflow)
  $exceed_raw = $observed - $hist_max
  $exceed_pos = if($exceed_raw > 0, $exceed_raw, 0.0)
  $above_max_z = $exceed_pos / $safe_stddev
  $macd_z = $personal_z + $above_max_z
  $macd_momentum_score = $macd_z

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $active_days >= {{min_baseline_days}} and $macd_z >= {{anomaly_threshold}}

order:
  $macd_z desc
