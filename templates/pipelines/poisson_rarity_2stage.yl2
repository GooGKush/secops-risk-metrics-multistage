// ============================================================================
// ARCHITECTURE: 2-STAGE DISCRETE POISSON RARITY OUTLIER PIPELINE
// Skill: secops-risk-metrics-multistage
// Purpose: Detects sudden execution of historically near-zero rare events
// Formula: Z_P = (k - lambda) / if(poisson_sigma > 0, poisson_sigma, 1.0) where poisson_sigma = math.sqrt(lambda)
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// Slots event_filter / macro_event_filter: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// 1. Rare User Authentication Failures:
//    - event_filter slot: metadata.event_type = "USER_LOGIN" AND not security_result.action = "ALLOW", entity_field slot: target.user.userid
//    - observed_aggregation slot: count(metadata.id), target_metric_name slot: auth_attempts_fail
//    - dimension_key slot: target.user.userid
// 2. Rare Failed File Executions:
//    - event_filter slot: metadata.event_type = "PROCESS_LAUNCH" AND not security_result.action = "ALLOW", entity_field slot: principal.asset.hostname
//    - Companion Dimension: principal.process.file.sha256 = $sha (CRITICAL: NEVER target.process.file.sha256)
//    - target_metric_name slot: file_executions_fail (requires metadata.event_type: $event_type, principal.asset.hostname: $entity, principal.process.file.sha256: $sha)
// ============================================================================

// Stage 1: Rare Telemetry Extraction & 30d Historical Lambda Lookup
stage stage1_extract {
    {{event_filter}}
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $observed_val = {{observed_aggregation}}
    $observed_events = count(metadata.id)

    $historical_avg = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: avg,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_stddev = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: stddev,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_active_days = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: num_metric_periods,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_max = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: max,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_sum = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: sum,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
}

// Stage 2 (Root Stage): Poisson Rarity Z-Score Evaluation
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $k = max($stage1_extract.observed_val)
  $lambda = max($stage1_extract.historical_avg)
  $active_days = max($stage1_extract.historical_active_days)

  // Discrete Poisson Rarity Z-Score
  $poisson_sigma = math.sqrt($lambda)
  $poisson_z = ($k - $lambda) / if($poisson_sigma > 0, $poisson_sigma, 1.0)

order:
  $poisson_z desc
