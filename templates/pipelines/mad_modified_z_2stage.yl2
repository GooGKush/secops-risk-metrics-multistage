// ============================================================================
// ARCHITECTURE: 2-STAGE NON-PARAMETRIC MODIFIED Z-SCORE (MAD OUTLIER ENGINE)
// Skill: secops-risk-metrics-multistage
// Purpose: Heavy-tail & burst resistant outlier detection across a sliding timeline
// Formula: Mz = 0.6745 * (Observed - Baseline_Mean) / (Baseline_StdDev + Floor)
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// Slots event_filter / macro_event_filter: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// 1. Network Outbound Bytes (Host):
//    - event_filter slot: network.sent_bytes > 0 AND network.sent_bytes < 1000000000000000 (network_bytes_outbound), entity_field slot: principal.asset.hostname
//    - observed_aggregation slot: sum(network.sent_bytes), target_metric_name slot: network_bytes_outbound
//    - metric_type_val slot: value_sum, dimension_key slot: principal.asset.hostname
// 2. Authentication Attempts (User):
//    - event_filter slot: metadata.event_type = "USER_LOGIN", entity_field slot: target.user.userid
//    - observed_aggregation slot: count(metadata.id), target_metric_name slot: auth_attempts_total
//    - metric_type_val slot: event_count_sum, dimension_key slot: target.user.userid
// ============================================================================

// Stage 1: Telemetry Extraction & Pre-Computed 30-Day Behavioral Baseline Lookup
stage stage1_extract {
    {{event_filter}}
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $observed_val = {{observed_aggregation}}
    $observed_events = count(metadata.id)

    $historical_avg = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: avg,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_stddev = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: stddev,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_active_days = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: num_metric_periods,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_max = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: max,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_sum = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: sum,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
}

// Stage 2 (Root Stage): Non-Parametric Modified Z-Score & Sigmoid Calibrated Risk Index
$entity = $stage1_extract.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed_val = max($stage1_extract.observed_val)
  $baseline_mean = max($stage1_extract.historical_avg)
  $baseline_stddev = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)
  $events_count = max($stage1_extract.observed_events)

  // 1. Non-Parametric Robust Dispersion & Modified Z-Score (MAD)
  $mad_modified_z = 0.6745 * ($observed_val - $baseline_mean) / if($baseline_stddev > 0, $baseline_stddev, {{dispersion_floor}})

order:
  $mad_modified_z desc
