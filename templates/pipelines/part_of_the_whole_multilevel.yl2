// ============================================================================
// ARCHITECTURE: 3-PART HIERARCHICAL MULTILEVEL PART-OF-THE-WHOLE DAG
// Skill: secops-risk-metrics-multistage
// Purpose: Evaluates an individual against their personal 30-day baseline,
//          their immediate peer team cohort, and the entire enterprise population.
// Math: Multilevel Z-Scores: Z_Personal, Z_vs_Team, Z_vs_Enterprise
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// 1. User Authentication Attempts:
//    - {{event_type}}: "USER_LOGIN", {{entity_field}}: target.user.userid, {{entity_var}}: $user
//    - {{observation_agg}}: count(metadata.id)
//    - {{target_metric_func_avg}}: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, target.user.userid: $user)
//    - {{target_metric_func_stddev}}: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, target.user.userid: $user)
// 2. Host Network Egress Outbound Bytes:
//    - {{event_type}}: "NETWORK_CONNECTION", {{entity_field}}: principal.asset.hostname, {{entity_var}}: $host
//    - {{observation_agg}}: sum(network.sent_bytes)
//    - {{target_metric_func_avg}}: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: avg, principal.asset.hostname: $host)
//    - {{target_metric_func_stddev}}: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: stddev, principal.asset.hostname: $host)
// ============================================================================

// Stage 1: Enterprise Population Telemetry + 30-Day Historical Baselines
stage all_entities {
    metadata.event_type = "{{event_type}}"
    {{entity_field}} = {{entity_var}}
    {{entity_var}} != ""

  match:
    {{entity_var}} by 1d

  outcome:
    $obs = {{observation_agg}}
    $personal_avg = max({{target_metric_func_avg}})
    $personal_std = max({{target_metric_func_stddev}})

    // In-Stage Personal Historical Z-Score (Outcomes-in-Outcomes)
    $z_personal = ($obs - $personal_avg) / if($personal_std > 0, $personal_std, 1.0)
}

// Stage 2: Team Cohort Whole (Macro baseline across designated peers)
stage team_cohort_stats {
    $u = $all_entities.{{entity_name}}
    $ws = $all_entities.window_start
    {{cohort_filter}}

  match:
    $ws by 1d

  outcome:
    $team_avg = avg($all_entities.obs)
    $team_std = stddev($all_entities.obs)
    $team_size = count_distinct($all_entities.{{entity_name}})
}

// Stage 3: Enterprise Whole (Macro baseline across the entire organization)
stage enterprise_stats {
    $ws = $all_entities.window_start

  match:
    $ws by 1d

  outcome:
    $fleet_avg = avg($all_entities.obs)
    $fleet_std = stddev($all_entities.obs)
    $fleet_size = count_distinct($all_entities.{{entity_name}})
}

// Root Stage: The "One" (or Team Members) Evaluated Against Both Wholes
{{entity_var}} = $all_entities.{{entity_name}}
$ws = $all_entities.window_start
$ws = $team_cohort_stats.ws
$ws = $enterprise_stats.ws

{{target_entity_filter}}

match:
  {{entity_var}}, $ws by 1d

outcome:
  $observed = max($all_entities.obs)
  $z_personal = max($all_entities.z_personal)

  $t_avg = max($team_cohort_stats.team_avg)
  $t_std = max($team_cohort_stats.team_std)

  $e_avg = max($enterprise_stats.fleet_avg)
  $e_std = max($enterprise_stats.fleet_std)

  // 1. Team Cross-Sectional Z-Score ("Part of the Team")
  $z_vs_team = ($observed - $t_avg) / if($t_std > 0, $t_std, 1.0)

  // 2. Enterprise Cross-Sectional Z-Score ("Part of the Enterprise")
  $z_vs_enterprise = ($observed - $e_avg) / if($e_std > 0, $e_std, 1.0)

order:
  $z_vs_team desc
