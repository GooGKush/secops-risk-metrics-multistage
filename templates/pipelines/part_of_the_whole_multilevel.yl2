// ============================================================================
// ARCHITECTURE: 3-PART HIERARCHICAL MULTILEVEL PART-OF-THE-WHOLE DAG
// Skill: secops-risk-metrics-multistage
// Purpose: Evaluates an individual against their personal 30-day baseline and
//          the entire enterprise population; optionally also against a named peer
//          group, and that group as a whole against the enterprise.
// Math: Multilevel Z-Scores: Z_Personal, Z_vs_Enterprise[, Z_vs_Team, Z_Team_vs_Enterprise]
//
// PEER GROUP (default = fleet only):
//   No peers mentioned -> delete every block between "// >>> TEAM COHORT" and
//   "// <<< TEAM COHORT" (3 blocks) and keep "order: $z_vs_enterprise desc".
//   Peers mentioned but not named (e.g. "vs his team") -> resolve the team from Active
//   Directory in Turn 1 (AD TEAM LOOKUP in references/multi-stage-metrics-guide.md, Peer
//   group rule): the subject's department, else one AD group. Ask the analyst for the
//   roster only if AD has no team for the subject. Never drop the team comparison silently.
//   Roster known (named in the request, supplied in a later turn, or resolved from AD) ->
//   keep the blocks, fill cohort_filter ($u = "a" or $u = "b"), delete only the marker
//   lines, and order by $z_vs_team desc. Show the filled query in the Turn 1 Pre-Flight.
//   Path user -> group -> enterprise: $z_vs_team (one vs group), $z_team_vs_enterprise
//   (group mean vs fleet, in fleet std units; elevated = team campaign/rollout).
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// Slots event_filter / macro_event_filter: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// 1. User Authentication Attempts:
//    - event_filter slot: metadata.event_type = "USER_LOGIN", entity_field slot: target.user.userid, entity_var slot: $user
//    - observation_agg slot: count(metadata.id)
//    - target_metric_func_avg slot: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, target.user.userid: target.user.userid)
//    - target_metric_func_stddev slot: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, target.user.userid: target.user.userid)
// 2. Host Network Egress Outbound Bytes:
//    - event_filter slot: network.sent_bytes > 0 AND network.sent_bytes < 1000000000000000 (network_bytes_outbound), entity_field slot: principal.asset.hostname, entity_var slot: $host
//    - observation_agg slot: sum(network.sent_bytes)
//    - target_metric_func_avg slot: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
//    - target_metric_func_stddev slot: metrics.network_bytes_outbound(period: 1d, window: 30d, metric: value_sum, agg: stddev, principal.asset.hostname: principal.asset.hostname)
// ============================================================================

// Stage 1: Enterprise Population Telemetry + 30-Day Historical Baselines
stage all_entities {
    {{event_filter}}
    {{entity_field}} = {{entity_var}}
    {{entity_var}} != ""

  match:
    {{entity_var}} by 1d

  outcome:
    $obs = {{observation_agg}}
    $personal_avg = max({{target_metric_func_avg}})
    $personal_std = max({{target_metric_func_stddev}})

    // In-Stage Personal Historical Z-Score (Outcomes-in-Outcomes)
    $z_personal = ($obs - $personal_avg) / if($personal_std > 0, $personal_std, 1.0)
}

// >>> TEAM COHORT
// Optional stage 2: Team Cohort Whole (Macro baseline across the named peers)
stage team_cohort_stats {
    $u = $all_entities.{{entity_name}}
    $ws = $all_entities.window_start
    {{cohort_filter}}

  match:
    $ws by 1d

  outcome:
    $team_avg = avg($all_entities.obs)
    $team_std = stddev($all_entities.obs)
    $team_size = count_distinct($all_entities.{{entity_name}})
}
// <<< TEAM COHORT

// Stage 3: Enterprise Whole (Macro baseline across the entire organization)
stage enterprise_stats {
    $ws = $all_entities.window_start

  match:
    $ws by 1d

  outcome:
    $fleet_avg = avg($all_entities.obs)
    $fleet_std = stddev($all_entities.obs)
    $fleet_size = count_distinct($all_entities.{{entity_name}})
}

// Root Stage: The "One" (or Team Members) Evaluated Against Both Wholes
{{entity_var}} = $all_entities.{{entity_name}}
$ws = $all_entities.window_start
// >>> TEAM COHORT
$ws = $team_cohort_stats.ws
// <<< TEAM COHORT
$ws = $enterprise_stats.ws

{{target_entity_filter}}

match:
  {{entity_var}}, $ws by 1d

outcome:
  $observed = max($all_entities.obs)
  $z_personal = max($all_entities.z_personal)

  $e_avg = max($enterprise_stats.fleet_avg)
  $e_std = max($enterprise_stats.fleet_std)
  $fleet_size = max($enterprise_stats.fleet_size)

  // >>> TEAM COHORT
  // Peer group only: one vs group, and the group as a whole vs the enterprise
  $t_avg = max($team_cohort_stats.team_avg)
  $t_std = max($team_cohort_stats.team_std)
  $team_size = max($team_cohort_stats.team_size)

  // 1. Team Cross-Sectional Z-Score ("Part of the Team")
  $z_vs_team = ($observed - $t_avg) / if($t_std > 0, $t_std, 1.0)

  // 3. Group vs Enterprise ("Team as Part of the Enterprise"): team mean in fleet std units
  $z_team_vs_enterprise = ($t_avg - $e_avg) / if($e_std > 0, $e_std, 1.0)
  // <<< TEAM COHORT

  // 2. Enterprise Cross-Sectional Z-Score ("Part of the Enterprise")
  $z_vs_enterprise = ($observed - $e_avg) / if($e_std > 0, $e_std, 1.0)

order:
  $z_vs_enterprise desc
