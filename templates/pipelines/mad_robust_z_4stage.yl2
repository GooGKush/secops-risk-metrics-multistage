// ============================================================================
// ARCHITECTURE: 4-STAGE ROBUST MODIFIED Z-SCORE (TRUE MEDIAN ABSOLUTE DEVIATION)
// Skill: secops-risk-metrics-multistage
// Purpose: Median-anchored outlier scoring that resists historic bursts, reported side by side with
//          the classical 30d metrics.* Z so masking is visible ($z_gap).
// Stages: stage1_extract (event stage, daily observed + 30d metrics baseline)
//         -> mad_center (median of daily values) -> mad_spread (MAD, mean abs dev) -> root (scores)
// Formula: modified_z = (x - median) / robust_scale,  robust_scale = MAD/0.6745  (MAD > 0)
//                                                        = 1.253314*meanAD   (MAD = 0)
//                                                        = 0.05*median + 1   (flat history)
//          Equivalent to Iglewicz-Hoaglin 0.6745*(x - median)/MAD. Default threshold: modified_z >= 3.5.
//
// SEARCH WINDOW CONTRACT: the raw search window IS the robust baseline. Use ~30d ending now
//   (udm_search practical max ~1 month). {{first_scored_date}} (UTC YYYY-MM-DD) = the end date for
//   Mode A (today only), or end date minus (N-1) days for a Mode B N-day (2-14) scoring timeline.
//   {{min_baseline_days}} = minimum active days required for a median (default 7).
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// Slots event_filter / macro_event_filter: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// 1. Network Outbound Bytes (Host):
//    - event_filter slot: network.sent_bytes > 0 AND network.sent_bytes < 1000000000000000 (network_bytes_outbound), entity_field slot: principal.asset.hostname
//    - observed_aggregation slot: sum(network.sent_bytes), target_metric_name slot: network_bytes_outbound
//    - metric_type_val slot: value_sum, dimension_key slot: principal.asset.hostname
// 2. Authentication Attempts (User):
//    - event_filter slot: metadata.event_type = "USER_LOGIN", entity_field slot: target.user.userid
//    - observed_aggregation slot: count(metadata.id), target_metric_name slot: auth_attempts_total
//    - metric_type_val slot: event_count_sum, dimension_key slot: target.user.userid
// window.median(..., false): the 2nd arg is should_ignore_zero_values; true would drop zero deviations and inflate MAD.
// Caveats (zero-activity days, scored day in baseline, historical end dates): see stage2_math_models/mad.yl2.
// ============================================================================

// Stage 1: Telemetry Extraction & Pre-Computed 30-Day Behavioral Baseline Lookup
stage stage1_extract {
    {{event_filter}}
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $observed_val = {{observed_aggregation}}
    $observed_events = count(metadata.id)
    $in_scoring_window = max(if(timestamp.get_date(metadata.event_timestamp.seconds) >= "{{first_scored_date}}", 1, 0))

    $historical_avg = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: avg,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_stddev = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: stddev,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_active_days = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: num_metric_periods,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_max = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: max,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_sum = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: sum,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
}

stage mad_center {
    $entity = $stage1_extract.entity

  match:
    $entity

  outcome:
    $median_val = window.median($stage1_extract.observed_val, false)
    $raw_active_days = count_distinct($stage1_extract.window_start)
}

stage mad_spread {
    $entity = $stage1_extract.entity
    $entity = $mad_center.entity

  match:
    $entity

  outcome:
    $mad = window.median(math.abs($stage1_extract.observed_val - $mad_center.median_val), false)
    $mean_abs_dev = avg(math.abs($stage1_extract.observed_val - $mad_center.median_val))
    $median_val = max($mad_center.median_val)
    $raw_active_days = max($mad_center.raw_active_days)
}

// Root Stage: Robust Modified Z (MAD) vs Classical 30d Metrics Z, scored from {{first_scored_date}} onward
$entity = $stage1_extract.entity
$entity = $mad_spread.entity
$ws = $stage1_extract.window_start

match:
  $entity, $ws by 1d

outcome:
  $observed = max($stage1_extract.observed_val)
  $hist_avg = max($stage1_extract.historical_avg)
  $hist_stddev = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)
  $median_val = max($mad_spread.median_val)
  $mad = max($mad_spread.mad)
  $mean_abs_dev = max($mad_spread.mean_abs_dev)
  $raw_active_days = max($mad_spread.raw_active_days)
  $in_scoring_window = max($stage1_extract.in_scoring_window)

  // 1. Classical 30d metrics Z (cross-check)
  $safe_stddev = if($hist_stddev > 0, $hist_stddev, 1.0)
  $personal_z = ($observed - $hist_avg) / $safe_stddev

  // 2. Robust scale with Iglewicz-Hoaglin MAD=0 fallback and flat-history floor
  $scale_from_mad = $mad / 0.6745
  $scale_from_meanad = $mean_abs_dev * 1.253314
  $robust_scale = if($mad > 0, $scale_from_mad, $scale_from_meanad)
  $median_floor = $median_val * 0.05 + 1.0
  $safe_robust_scale = if($robust_scale > 0, $robust_scale, $median_floor)

  // 3. Modified Z-score and masking gap
  $modified_z = ($observed - $median_val) / $safe_robust_scale
  $z_gap = $modified_z - $personal_z

condition:
  $in_scoring_window = 1 and $raw_active_days >= {{min_baseline_days}}

order:
  $modified_z desc
