// ============================================================================
// ARCHITECTURE: 2-STAGE DUAL-PLANE DERIVED CONTEXT DOMAIN PREVALENCE PIPELINE
// Skill: secops-risk-metrics-multistage
// Purpose: Fuses 30-day host/domain query volumetric baseline (metrics.http_queries_total
//          or metrics.dns_queries_total) with Chronicle Entity Context Graph
//          (DERIVED_CONTEXT) domain prevalence to isolate rare/unseen external
//          destinations and prune routine corporate SaaS/CDN traffic.
// Join Budget: 1 metric lookup (Stage 1) + 1 stage join (Root) = 2 joins total (<= 4).
// Invariant: Stage 1 evaluates universal volume; Stage 2 isolates graph lookup (ECG_LIMIT = 1).
//
// ENTITY GRAPH FRESHNESS (references/entity-context-graph-guide.md, Rule 5):
//   Daily graph records (every prevalence.* filter) are built once a day and lag about a
//   day; a window starting today 00:00Z overlaps none of them, the inner join drops every
//   row, and zero rows are structural, not a true negative. Start the search window two
//   days back at 00:00Z; the today_date slot (today's UTC date, YYYY-MM-DD) keeps the event
//   stage on the analysis day. The graph stage matches by key only (no time predicate).
//   Zero rows from a window starting today is a freshness gap: rerun, do not report clean.
// FILTER ONLY: the graph stage is an inner join. Entities with no graph record drop out
//   (absent from the graph is not the same as rare); say so in the report.
// IDENTIFIER: probe that principal.asset.hostname is populated in this sector first. Network
//   sensors (Zeek, proxies) often fill only principal.asset.ip; swap it into the event line and
//   both metric calls (PRINCIPAL_DEVICE). Baseline days are evidence, not a gate: a gate on
//   active days would exclude exactly the new pairs the novelty multiplier exists to catch.
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// Slots event_filter / macro_event_filter: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// 1. Web / HTTP Destination Domain:
//    - event_filter slot: (network.http.method != "" or network.http.user_agent != "" or network.http.response_code != 0 or network.http.referral_url != "")
//    - domain_field slot: target.hostname
//    - target_metric_func_avg slot: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: $host, target.hostname: $domain)
//    - target_metric_func_stddev slot: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, principal.asset.hostname: $host, target.hostname: $domain)
//    - target_metric_func_active_days slot: metrics.http_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods, principal.asset.hostname: $host, target.hostname: $domain)
// 2. DNS Query Destination Domain (config-valid, but probe first: the DNS_DOMAIN dimension reads
//    network.dns_domain, which is empty on some tenants. If it is empty, use
//    rare_destination_ecg_3stage.yl2 with network.dns.questions.name as the destination):
//    - event_filter slot: (network.dns.questions.name != "" or network.dns.answers.name != "" or network.dns.id != 0)
//    - domain_field slot: network.dns_domain
//    - target_metric_func_avg slot: metrics.dns_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: $host, network.dns_domain: $domain)
//    - target_metric_func_stddev slot: metrics.dns_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, principal.asset.hostname: $host, network.dns_domain: $domain)
//    - target_metric_func_active_days slot: metrics.dns_queries_total(period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods, principal.asset.hostname: $host, network.dns_domain: $domain)
// ============================================================================

// Stage 1: Macro 30-Day Destination Query Baseline (metrics.*)
stage stage1_query_baseline {
    {{event_filter}}
    timestamp.get_date(metadata.event_timestamp.seconds) = "{{today_date}}"
    principal.asset.hostname = $host
    {{domain_field}} = $domain
    $host != ""
    $domain != ""

  match:
    $host, $domain by 1d

  outcome:
    $observed_val = count(metadata.id)
    $distinct_ports = count_distinct(target.port)

    $hist_mean = max({{target_metric_func_avg}})
    $hist_stddev = max({{target_metric_func_stddev}})
    $hist_active_days = max({{target_metric_func_active_days}})
    $event_timestamp = max(metadata.event_timestamp.seconds)
}

// Stage 2: Chronicle Derived Context Graph Lookup (Domain Prevalence & First Seen)
stage stage2_domain_derived_context {
    $dom.graph.metadata.source_type = "DERIVED_CONTEXT"
    $dom.graph.metadata.entity_type = "DOMAIN_NAME"
    $dom.graph.entity.domain.name = $domain
    $dom.graph.entity.domain.prevalence.day_count = 10
    $dom.graph.entity.domain.prevalence.rolling_max <= 3
    $dom.graph.entity.domain.prevalence.rolling_max > 0
    $domain != ""

  match:
    $domain

  outcome:
    $enterprise_day_count = min($dom.graph.entity.domain.prevalence.day_count)
    $enterprise_rolling_max = max($dom.graph.entity.domain.prevalence.rolling_max)
    $first_seen_ts = min($dom.graph.entity.domain.first_seen_time.seconds)
    $last_seen_ts = max($dom.graph.entity.domain.last_seen_time.seconds)
}

// Stage 3 (Root Stage): Fuses Personal Query Z-Score with Enterprise Domain Prevalence Multiplier
$host = $stage1_query_baseline.host
$domain = $stage1_query_baseline.domain
$domain = $stage2_domain_derived_context.domain

match:
  $host, $domain by 1d

outcome:
  $observed_queries = max($stage1_query_baseline.observed_val)
  $mean_queries = max($stage1_query_baseline.hist_mean)
  $stddev_queries = max($stage1_query_baseline.hist_stddev)
  $z_score = ($observed_queries - $mean_queries) / if($stddev_queries > 0, $stddev_queries, 1.0)
  $active_baseline_days = max($stage1_query_baseline.hist_active_days)

  $fleet_prevalence = max($stage2_domain_derived_context.enterprise_rolling_max)
  $prevalence_days = min($stage2_domain_derived_context.enterprise_day_count)
  $first_seen = min($stage2_domain_derived_context.first_seen_ts)
  $obs_ts = max($stage1_query_baseline.event_timestamp)
  $domain_age_days = ($obs_ts - $first_seen) / 86400.0

  // Rare Domain Multiplier: 2.5x threat score boost for novel destinations seen enterprise-wide on <= 3 hosts or first seen <= 7 days ago
  $is_novel_domain = if($domain_age_days <= 7.0 and $domain_age_days >= 0.0, 1.0, 0.0)
  $rarity_multiplier = if($is_novel_domain = 1.0, 2.5, 1.5)
  $threat_score = $z_score * $rarity_multiplier

condition:
  $z_score >= {{anomaly_threshold}}
  and $fleet_prevalence <= {{max_fleet_prevalence}}

order:
  $threat_score desc
