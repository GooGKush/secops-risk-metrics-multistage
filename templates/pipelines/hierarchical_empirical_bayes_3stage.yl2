// ============================================================================
// ARCHITECTURE: 3-STAGE HIERARCHICAL EMPIRICAL BAYES (FLEET GAMMA-NB PREDICTIVE Z)
// Skill: secops-risk-metrics-multistage
// Purpose: Pools mature organizational fleet rate variance to regularize sparse/moderately
//          active entities and scores today's count via the Negative-Binomial posterior-predictive
//          residual Z (WS3-BAYES / WS4-BAYES-ASSET).
// Math:
//   1. Rebuild 30-day calendar daily rate mu_cal = hist_sum / 30.0 and extra-Poisson calendar
//      variance excess_var = max(0, var_cal - mu_cal) (PF-1, B-E10: no double-counting of mu).
//   2. Estimate fleet Gamma(alpha0, beta0) hyperparameters via method of moments over mature
//      entities (hist_active_days >= min_baseline_days), falling back to ({{prior_alpha0}}, {{prior_beta0}})
//      when mature_n < 2 (e.g., single-entity filtered searches or cold-start fleets).
//   3. Conjugate pre-observation 30d posterior rate = (alpha0 + hist_sum) / (beta0 + 30.0) and
//      NB predictive variance = posterior_rate + post_rate_var + cred_w * excess_var.
//
// CONCRETE FIELD BINDING & INSTANTIATION GUIDE:
// entity_field slot: the entity key (default principal.asset.hostname); observed_agg slot: the metric's "Observed value".
// Slots event_filter / macro_event_filter: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// 1. Host Authentication Activity:
//    - event_filter slot: metadata.event_type = "USER_LOGIN"
//    - target_metric_func_sum slot: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: sum, principal.asset.hostname: principal.asset.hostname)
//    - target_metric_func_avg slot: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: avg, principal.asset.hostname: principal.asset.hostname)
//    - target_metric_func_stddev slot: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: stddev, principal.asset.hostname: principal.asset.hostname)
//    - target_metric_func_active_days slot: metrics.auth_attempts_total(period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods, principal.asset.hostname: principal.asset.hostname)
// ============================================================================

// Stage 1: Individual Entity Daily Telemetry + 30d Calendar Rate & Extra-Poisson Dispersion
stage host_extract {
    {{event_filter}}
    {{entity_field}} = $host
    $host != ""

  match:
    $host by 1d

  outcome:
    $observed_24h = {{observed_agg}}
    $hist_sum = max({{target_metric_func_sum}})
    $hist_avg = max({{target_metric_func_avg}})
    $hist_stddev = max({{target_metric_func_stddev}})
    $hist_active_days = max({{target_metric_func_active_days}})

    $mu_cal = $hist_sum / 30.0
    $mu_cal_sq = $mu_cal * $mu_cal
    $df_minus_one = if($hist_active_days > 1, $hist_active_days, 1) - 1
    $sum_x2 = ($df_minus_one * $hist_stddev * $hist_stddev) + ($hist_active_days * $hist_avg * $hist_avg)
    $raw_var_cal = ($sum_x2 / 30.0) - $mu_cal_sq
    $var_cal = if($raw_var_cal > 0.0, $raw_var_cal, 0.0)
    $raw_excess_var = $var_cal - $mu_cal
    $excess_var = if($hist_active_days >= 2 and $raw_excess_var > 0.0, $raw_excess_var, 0.0)
}

// Stage 2: Mature-Entity Fleet Gamma(alpha0, beta0) Hyperprior Estimation
stage fleet_hyperpriors {
    $host = $host_extract.host
    $ws = $host_extract.window_start

  match:
    $ws by 1d

  outcome:
    $active_hosts = count_distinct($host_extract.host)
    $mature_n = sum(if($host_extract.hist_active_days >= {{min_baseline_days}}, 1, 0))
    $mature_sum_r = sum(if($host_extract.hist_active_days >= {{min_baseline_days}}, $host_extract.mu_cal, 0.0))
    $mature_sum_r2 = sum(if($host_extract.hist_active_days >= {{min_baseline_days}}, $host_extract.mu_cal_sq, 0.0))

    $safe_n = if($mature_n > 0, $mature_n, 1)
    $fleet_mean = $mature_sum_r / $safe_n
    $raw_df = $mature_n - 1
    $safe_df = if($raw_df > 0, $raw_df, 1)
    $raw_fleet_var = ($mature_sum_r2 - ($mature_n * $fleet_mean * $fleet_mean)) / $safe_df
    $safe_fleet_var = if($raw_fleet_var > 0.01, $raw_fleet_var, 1.0)
    $eb_beta = $fleet_mean / $safe_fleet_var
    $eb_alpha = $fleet_mean * $eb_beta

    $alpha0 = if($mature_n >= 2 and $fleet_mean > 0.0 and $raw_fleet_var > 0.01, $eb_alpha, {{prior_alpha0}})
    $beta0 = if($mature_n >= 2 and $fleet_mean > 0.0 and $raw_fleet_var > 0.01, $eb_beta, {{prior_beta0}})
}

// Stage 3 (Root Stage): Hierarchical Empirical Bayes NB Predictive Residual Z
$host = $host_extract.host
$ws = $host_extract.window_start
$ws = $fleet_hyperpriors.ws

match:
  $host, $ws by 1d

outcome:
  $obs_24h = max($host_extract.observed_24h)
  $hist_sum = max($host_extract.hist_sum)
  $host_avg = max($host_extract.hist_avg)
  $host_std = max($host_extract.hist_stddev)
  $host_active_days = max($host_extract.hist_active_days)
  $excess_var = max($host_extract.excess_var)

  $fleet_mu = max($fleet_hyperpriors.fleet_mean)
  $alpha0 = max($fleet_hyperpriors.alpha0)
  $beta0 = max($fleet_hyperpriors.beta0)

  // 1. Pre-Observation 30-Day Conjugate Posterior Rate
  $post_alpha_pre = $alpha0 + $hist_sum
  $post_beta_pre = $beta0 + 30.0
  $posterior_rate = $post_alpha_pre / $post_beta_pre
  $post_rate_var = $post_alpha_pre / ($post_beta_pre * $post_beta_pre)

  // 2. Posterior-Predictive Negative-Binomial Residual Z (no double-counting of mu)
  $cred_w = $host_active_days / ($host_active_days + $beta0)
  $pred_var = $posterior_rate + $post_rate_var + ($cred_w * $excess_var)
  $safe_pred_sd = math.sqrt(if($pred_var > 1.0, $pred_var, 1.0))
  $bayesian_z = ($obs_24h - $posterior_rate) / $safe_pred_sd

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $bayesian_z >= {{anomaly_threshold}}

order:
  $bayesian_z desc
