// ============================================================================
// ARCHITECTURE: 2-STAGE LONGITUDINAL CUSUM BEHAVIORAL DRIFT PIPELINE
// Skill: secops-risk-metrics-multistage
// Purpose: Detects quiet, low-and-slow behavioral drift across up to 14 days (multi-stage search limit).
//          One request anchors ONE 30d baseline at its start day, so every day is scored against the
//          same pre-window reference: the fixed reference CUSUM needs. Do not split CUSUM into Mode C shards.
// Formula: S_t^+ = max(0, S_{t-1}^+ + ((x_t - mu) / if(sigma > 0, sigma, 1.0) - k_ref))
// event_filter slot: the metric's "Observed event filter" lines from references/metric-sector-catalog.md, one per line.
// Telemetry Metric Mappings:
//   - DNS Query Volume (Counts): metrics.dns_queries_total (metric: event_count_sum, obs: count(metadata.id))
//   - DNS Byte Volume (Bandwidth): metrics.dns_bytes_outbound (metric: value_sum, obs: sum(network.sent_bytes))
//   - Network Bytes (Outbound): metrics.network_bytes_outbound (metric: value_sum, obs: sum(network.sent_bytes))
// ============================================================================

// Stage 1: Daily Standardized Deviation Tracker
stage stage1_extract {
    {{event_filter}}
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $observed_val = {{observed_aggregation}}
    $observed_events = count(metadata.id)

    $historical_avg = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: avg,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_stddev = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: stddev,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_active_days = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: num_metric_periods,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_max = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: max,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    $historical_sum = max(metrics.{{target_metric_name}}(
        period: 1d, window: 30d, metric: {{metric_type_val}}, agg: sum,
        {{dimension_key}}: {{dimension_key}} {{extra_dimensions}}
    ))
    // Per-day standardized CUSUM slack excess (k = 0.5 sigma)
    $daily_z = ($observed_val - $historical_avg) / if($historical_stddev > 0, $historical_stddev, 1.0)
    $deviation = $daily_z - 0.5
    $daily_excess = if($deviation > 0.0, $deviation, 0.0)
}

// Stage 2 (Root Stage): Longitudinal Drift Score & Timeline Breakdown
$entity = $stage1_extract.entity

match:
  $entity

outcome:
  $observed_val = max($stage1_extract.observed_val)
  $baseline_mean = max($stage1_extract.historical_avg)
  $baseline_stddev = max($stage1_extract.historical_stddev)
  $active_days = max($stage1_extract.historical_active_days)

  // 1. Peak Daily Standardized Shift across the multi-day window
  $daily_z = max($stage1_extract.daily_z)

  // 2. Multi-day Cumulative Sum of Positive Drift Increments across days
  $slack_excess = sum($stage1_extract.daily_excess)
  $cusum_drift = $slack_excess
  $cusum_drift_score = $cusum_drift
  $drift_days = sum(if($stage1_extract.daily_excess > 0.0, 1, 0))

// Significance gate: the Pre-Flight card's threshold for this model (references/model-concordance-guide.md §2.1).
condition:
  $cusum_drift_score > 0.0 and $drift_days >= 2

order:
  $cusum_drift_score desc
