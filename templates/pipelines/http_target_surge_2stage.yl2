// ============================================================================
// ARCHITECTURE: 2-STAGE TARGET HOSTNAME SURGE PIPELINE
// Skill: secops-risk-metrics-multistage
// Common Compiler Conformance: YARA-L 2.0 Multi-Stage DAG Engine
// Models Supported:
//   Target Destination Rarity & Host Volume Surge (sub-hour C2 periodicity/jitter hands off to secops-statistical-hunter)
// Join Budget: 1 metric lookup (Stage 1) + 1 stage join (Root) = 2 joins total (<= 4).
// Match Topology: Destination-centric match key ($target_host by 1d) joining host surge to fleet breadth.
// ============================================================================

// Stage 1: Host-to-Target HTTP Request Surge (metrics.http_queries_total)
stage stage1_target_surge {
    (network.http.method != "" or network.http.user_agent != "" or network.http.response_code != 0 or network.http.referral_url != "")
    principal.asset.hostname = $host
    $host != ""
    target.hostname = $target_host
    $target_host != ""
    not re.regex($target_host, `(?i)\.(in-addr\.arpa|ip6\.arpa|local)$`)

  match:
    $host, $target_host by 1d

  outcome:
    $observed_val = count(metadata.id)
    $distinct_uris = count_distinct(target.url)

    $hist_mean = max(metrics.http_queries_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.asset.hostname: principal.asset.hostname,
        target.hostname: target.hostname
    ))
    $hist_stddev = max(metrics.http_queries_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.asset.hostname: principal.asset.hostname,
        target.hostname: target.hostname
    ))
    $hist_active_days = max(metrics.http_queries_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.asset.hostname: principal.asset.hostname,
        target.hostname: target.hostname
    ))

    $dispersion_floor = math.sqrt(if($hist_mean > 1.0, $hist_mean, 1.0))
    $target_z = ($observed_val - $hist_mean) / if($hist_stddev > $dispersion_floor, $hist_stddev, $dispersion_floor)
    $origin_host = array_distinct($host)
}

// Stage 2: Enterprise Fleet Breadth for the Target Hostname
stage stage2_fleet_target_breadth {
    (network.http.method != "" or network.http.user_agent != "" or network.http.response_code != 0 or network.http.referral_url != "")
    target.hostname = $target_host
    $target_host != ""
    not re.regex($target_host, `(?i)\.(in-addr\.arpa|ip6\.arpa|local)$`)

  match:
    $target_host by 1d

  outcome:
    $connecting_hosts = count_distinct(principal.asset.hostname)
    $total_target_events = count(metadata.id)
}

// Stage 3 (Root Stage): Destination Outlier Odds Fusion
$target_host = $stage1_target_surge.target_host
$target_host = $stage2_fleet_target_breadth.target_host

match:
  $target_host by 1d

outcome:
  $originating_hosts = array_distinct($stage1_target_surge.origin_host)
  $target_z = max($stage1_target_surge.target_z)
  $active_baseline_days = max($stage1_target_surge.hist_active_days)
  $connecting_fleet_hosts = max($stage2_fleet_target_breadth.connecting_hosts)
  $total_events = max($stage2_fleet_target_breadth.total_target_events)

  // Dampen if the destination hostname is widely adopted across the enterprise fleet
  $prevalence_dampener = 1.0 / ($connecting_fleet_hosts + 1.0)
  $target_risk_score = $target_z * $prevalence_dampener

condition:
  $active_baseline_days >= 7
  and $target_z >= 3.0
  and $connecting_fleet_hosts <= 2

order:
  $target_risk_score desc
