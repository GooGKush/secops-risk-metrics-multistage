// ============================================================================
// ARCHITECTURE: 2-STAGE OUTBOUND FLOW SURGE PIPELINE (FORMERLY C2 BEACON FLOW FREQUENCY)
// Skill: secops-risk-metrics-multistage
// Common Compiler Conformance: YARA-L 2.0 Multi-Stage DAG Engine
// Purpose: Detects daily outbound network flow count surges against a 30-day entity baseline
//          with single-scan target destination breadth enrichment (D1 / WS4-D1).
//          Note: Sub-hour callback periodicity / interval jitter requires raw inter-arrival
//          timestamps and hands off to secops-statistical-hunter C2_BEACONING_JITTER.
// Join Budget: 1 metric lookup (Stage 1) + 0 inter-stage joins (Root) = 1 join total (<= 4).
// Match Topology: Single UDM scan ($host by 1d) combining flow surge Z with destination breadth.
// ============================================================================

// Stage 1: Personal Host Outbound Flow Baseline, Payload Density & Destination Breadth
stage stage1_outbound_flow_surge {
    network.sent_bytes > 0
    network.sent_bytes < 1000000000000000
    principal.asset.hostname = $host
    $host != ""

  match:
    $host by 1d

  outcome:
    $observed_flows = count(metadata.id)
    $observed_bytes = sum(network.sent_bytes)
    $distinct_dst_ips = count_distinct(target.ip)
    $distinct_dst_ports = count_distinct(target.port)
    $sample_dst_ips = array_distinct(target.ip)

    $hist_flow_avg = max(metrics.network_flows_outbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.asset.hostname: principal.asset.hostname
    ))
    $hist_flow_stddev = max(metrics.network_flows_outbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.asset.hostname: principal.asset.hostname
    ))
    $hist_flow_active_days = max(metrics.network_flows_outbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.asset.hostname: principal.asset.hostname
    ))
    $hist_flow_max = max(metrics.network_flows_outbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: max,
        principal.asset.hostname: principal.asset.hostname
    ))

    $dispersion_floor = math.sqrt(if($hist_flow_avg > 1.0, $hist_flow_avg, 1.0))
    $flow_z = ($observed_flows - $hist_flow_avg) / if($hist_flow_stddev > $dispersion_floor, $hist_flow_stddev, $dispersion_floor)
    $bytes_per_flow = (1.0 * $observed_bytes) / ($observed_flows + 0.001)
}

// Stage 2 (Root Stage): Outbound Flow Surge Scoring & Target Breadth Summary
$host = $stage1_outbound_flow_surge.host

match:
  $host by 1d

outcome:
  $flow_z = max($stage1_outbound_flow_surge.flow_z)
  $flow_surge_score = $flow_z
  $active_days = max($stage1_outbound_flow_surge.hist_flow_active_days)
  $observed_flows = max($stage1_outbound_flow_surge.observed_flows)
  $observed_bytes = max($stage1_outbound_flow_surge.observed_bytes)
  $bytes_per_flow = max($stage1_outbound_flow_surge.bytes_per_flow)
  $distinct_ips = max($stage1_outbound_flow_surge.distinct_dst_ips)
  $distinct_ports = max($stage1_outbound_flow_surge.distinct_dst_ports)
  $sample_ips = array_distinct($stage1_outbound_flow_surge.sample_dst_ips)

condition:
  $active_days >= 7
  and $flow_z >= 3.0
  and $observed_flows >= 50

order:
  $flow_surge_score desc
