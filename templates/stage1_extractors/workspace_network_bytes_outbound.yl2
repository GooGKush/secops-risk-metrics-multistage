// Stage 1: Google Workspace Outbound Network Bytes & 30d Baseline
// Identifier swap: this extractor keys on `principal.user.userid`. Any ONE field below is valid alone for workspace_network_bytes_outbound;
//   replace it in the event binding AND in every metrics call, keeping the same variable:
//   - PRINCIPAL_USER (principal.user.userid | email_addresses | employee_id | product_object_id | windows_sid)
//   ip, mac and email_addresses are repeated fields: one event can count toward several entities.
stage stage1_extract {
    re.regex(metadata.product_name, `(?i)^gmail$`)
    network.sent_bytes > 0
    network.sent_bytes < 1000000000000000
    principal.user.userid = $user
    $user != ""

  match:
    $user by 1d

  outcome:
    $observed_val = sum(if(network.sent_bytes > 0 and network.sent_bytes < 1000000000000000, 1.0, 0.0) * network.sent_bytes)
    $observed_events = count(metadata.id)

    $historical_avg = max(metrics.workspace_network_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: avg,
        principal.user.userid: principal.user.userid
    ))
    $historical_stddev = max(metrics.workspace_network_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: stddev,
        principal.user.userid: principal.user.userid
    ))
    $historical_active_days = max(metrics.workspace_network_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: num_metric_periods,
        principal.user.userid: principal.user.userid
    ))
    $historical_max = max(metrics.workspace_network_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: max,
        principal.user.userid: principal.user.userid
    ))
    $historical_sum = max(metrics.workspace_network_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: sum,
        principal.user.userid: principal.user.userid
    ))
}
