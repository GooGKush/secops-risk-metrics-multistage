// Stage 1: Google Workspace Authentication Attempts & 30d Baseline
// Identifier swap: this extractor keys on `target.user.userid`. Any ONE field below is valid alone for workspace_auth_attempts_total;
//   replace it in the event binding AND in every metrics call, keeping the same variable:
//   - PRINCIPAL_USER (principal.user.userid | email_addresses | employee_id | product_object_id | windows_sid)
//   - TARGET_USER (target.user.userid | email_addresses | employee_id | product_object_id | windows_sid)
//   ip, mac and email_addresses are repeated fields: one event can count toward several entities.
stage stage1_extract {
    metadata.vendor_name = "Google Workspace"
    (metadata.product_name = "login" or metadata.product_name = "saml" or metadata.product_name = "token")
    target.user.userid = $user
    $user != ""

  match:
    $user by 1d

  outcome:
    $observed_val = count(metadata.id)
    $distinct_source_ips = count_distinct(principal.ip)

    $historical_avg = max(metrics.workspace_auth_attempts_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        target.user.userid: $user
    ))
    $historical_stddev = max(metrics.workspace_auth_attempts_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        target.user.userid: $user
    ))
    $historical_active_days = max(metrics.workspace_auth_attempts_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        target.user.userid: $user
    ))
    $historical_max = max(metrics.workspace_auth_attempts_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: max,
        target.user.userid: $user
    ))
    $historical_sum = max(metrics.workspace_auth_attempts_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: sum,
        target.user.userid: $user
    ))
}
