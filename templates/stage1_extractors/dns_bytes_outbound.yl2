// Stage 1: Outbound DNS Bytes & 30d Baseline
// Identifier swap: this extractor keys on `principal.asset.hostname`. Any ONE field below is valid alone for dns_bytes_outbound;
//   replace it in the event binding AND in every metrics call, keeping the same variable:
//   - PRINCIPAL_DEVICE (principal.asset.hostname | asset_id | ip | mac | product_object_id)
//   - PRINCIPAL_USER (principal.user.userid | email_addresses | employee_id | product_object_id | windows_sid)
//   ip, mac and email_addresses are repeated fields: one event can count toward several entities.
stage stage1_extract {
    network.sent_bytes > 0
    ((network.ip_protocol = "UDP" and target.port = 53) or (network.ip_protocol = "TCP" and (target.port = 53 or target.port = 3000)))
    $event_type = metadata.event_type
    principal.asset.hostname = $entity
    $entity != ""
    $sent = network.sent_bytes

  match:
    $entity by 1d

  outcome:
    $observed_val = sum($sent)
    $observed_queries = count(metadata.id)

    $historical_avg = max(metrics.dns_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: avg,
        principal.asset.hostname: principal.asset.hostname
    ))
    $historical_stddev = max(metrics.dns_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: stddev,
        principal.asset.hostname: principal.asset.hostname
    ))
    $historical_active_days = max(metrics.dns_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: num_metric_periods,
        principal.asset.hostname: principal.asset.hostname
    ))
    $historical_max = max(metrics.dns_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: max,
        principal.asset.hostname: principal.asset.hostname
    ))
    $historical_sum = max(metrics.dns_bytes_outbound(
        period: 1d, window: 30d, metric: value_sum, agg: sum,
        principal.asset.hostname: principal.asset.hostname
    ))
}
