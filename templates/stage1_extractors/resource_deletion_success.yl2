// Stage 1: Successful Cloud Resource Deletions with Local-Baseline Isolation
// Identifier swap: this extractor keys on `principal.user.userid` (PRINCIPAL_USER) plus companion fields that complete one valid set.
//   You may swap `principal.user.userid` for another PRINCIPAL_USER (principal.user.userid | email_addresses | employee_id | product_object_id | windows_sid) field, in the event binding
//   AND in every metrics call; keep every companion field (the set must match exactly). Sets keyed on
//   other entities: references/metric-sector-catalog.md (this metric's row).
stage stage1_extract {
    (metadata.event_type = "RESOURCE_DELETION" or metadata.event_type = "USER_RESOURCE_DELETION")
    security_result.action = "ALLOW"
    $sa = principal.user.userid
    $vendor = metadata.vendor_name
    $product = metadata.product_name
    $resource = target.resource.name
    $ip = principal.ip
    $resource != ""
    $sa != ""

  match:
    $sa, $vendor, $product, $resource, $ip by 1d

  outcome:
    $observed_val = count(metadata.id)
    $historical_avg = max(metrics.resource_deletion_success(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    $historical_stddev = max(metrics.resource_deletion_success(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    $historical_active_days = max(metrics.resource_deletion_success(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    $historical_max = max(metrics.resource_deletion_success(
        period: 1d, window: 30d, metric: event_count_sum, agg: max,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
    $historical_sum = max(metrics.resource_deletion_success(
        period: 1d, window: 30d, metric: event_count_sum, agg: sum,
        principal.user.userid: $sa,
        metadata.vendor_name: $vendor,
        metadata.product_name: $product,
        target.resource.name: $resource
    ))
}
