// Stage 1: Inbound Network Bytes & 30d Historical Baseline
stage stage1_extract {
    metadata.event_type = "NETWORK_CONNECTION"
    $event_type = metadata.event_type
    principal.asset.hostname = $entity
    $entity != ""
    $received = network.received_bytes

  match:
    $entity by 1d

  outcome:
    $observed_val = sum($received)
    $observed_connections = count(metadata.id)
    $distinct_source_ips = count_distinct(principal.ip)

    $historical_avg = max(metrics.network_bytes_inbound(
        period: 1d, window: 30d, metric: value_sum, agg: avg,
        principal.asset.hostname: $entity
    ))
    $historical_stddev = max(metrics.network_bytes_inbound(
        period: 1d, window: 30d, metric: value_sum, agg: stddev,
        principal.asset.hostname: $entity
    ))
    $historical_active_days = max(metrics.network_bytes_inbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.asset.hostname: $entity
    ))
    $historical_max = max(metrics.network_bytes_inbound(
        period: 1d, window: 30d, metric: value_sum, agg: max,
        principal.asset.hostname: $entity
    ))
    $historical_sum = max(metrics.network_bytes_inbound(
        period: 1d, window: 30d, metric: value_sum, agg: sum,
        principal.asset.hostname: $entity
    ))
}
