// Stage 1: Total Outbound Emails in Google Workspace & 30d Baseline
stage stage1_extract {
    metadata.event_type = "EMAIL_TRANSACTION"
    $event_type = metadata.event_type
    principal.user.userid = $user
    $user != ""

  match:
    $user by 1d

  outcome:
    $observed_val = count(metadata.id)
    $distinct_recipients = count_distinct(target.user.userid)

    $historical_avg = max(metrics.workspace_emails_sent_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.user.userid: $user
    ))
    $historical_stddev = max(metrics.workspace_emails_sent_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.user.userid: $user
    ))
    $historical_active_days = max(metrics.workspace_emails_sent_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.user.userid: $user
    ))
    $historical_max = max(metrics.workspace_emails_sent_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: max,
        principal.user.userid: $user
    ))
    $historical_sum = max(metrics.workspace_emails_sent_total(
        period: 1d, window: 30d, metric: event_count_sum, agg: sum,
        principal.user.userid: $user
    ))
}
