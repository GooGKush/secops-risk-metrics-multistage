// Stage 1: Failed/Blocked Process Executions & 30d Baseline
// Identifier swap: this extractor keys on `principal.asset.hostname` (PRINCIPAL_DEVICE) plus companion fields that complete one valid set.
//   You may swap `principal.asset.hostname` for another PRINCIPAL_DEVICE (principal.asset.hostname | asset_id | ip | mac | product_object_id) field, in the event binding
//   AND in every metrics call; keep every companion field (the set must match exactly). Sets keyed on
//   other entities: references/metric-sector-catalog.md (this metric's row).
stage stage1_extract {
    metadata.event_type = "PROCESS_LAUNCH"
    not security_result.action = "ALLOW"
    $event_type = metadata.event_type
    principal.asset.hostname = $host
    principal.process.file.sha256 = $sha256
    $host != ""
    $sha256 != ""

  match:
    $host, $sha256 by 1d

  outcome:
    $observed_val = count(metadata.id)
    $sample_command = array_distinct(principal.process.command_line)
    $sample_path = array_distinct(principal.process.file.full_path)
    $distinct_users = count_distinct(principal.user.userid)

    $historical_avg = max(metrics.file_executions_fail(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        metadata.event_type: $event_type,
        principal.asset.hostname: $host,
        principal.process.file.sha256: $sha256
    ))
    $historical_stddev = max(metrics.file_executions_fail(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        metadata.event_type: $event_type,
        principal.asset.hostname: $host,
        principal.process.file.sha256: $sha256
    ))
    $historical_active_days = max(metrics.file_executions_fail(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        metadata.event_type: $event_type,
        principal.asset.hostname: $host,
        principal.process.file.sha256: $sha256
    ))
    $historical_max = max(metrics.file_executions_fail(
        period: 1d, window: 30d, metric: event_count_sum, agg: max,
        metadata.event_type: $event_type,
        principal.asset.hostname: $host,
        principal.process.file.sha256: $sha256
    ))
    $historical_sum = max(metrics.file_executions_fail(
        period: 1d, window: 30d, metric: event_count_sum, agg: sum,
        metadata.event_type: $event_type,
        principal.asset.hostname: $host,
        principal.process.file.sha256: $sha256
    ))
}
