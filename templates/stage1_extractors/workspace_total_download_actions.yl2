// Stage 1: Google Workspace File Downloads & 30d Baseline
// Identifier swap: this extractor keys on `principal.user.userid`. Any ONE field below is valid alone for workspace_total_download_actions;
//   replace it in the event binding AND in every metrics call, keeping the same variable:
//   - PRINCIPAL_USER (principal.user.userid | email_addresses | employee_id | product_object_id | windows_sid)
//   ip, mac and email_addresses are repeated fields: one event can count toward several entities.
stage stage1_extract {
    metadata.vendor_name = "Google Workspace"
    metadata.product_event_type = "download"
    principal.user.userid = $user
    $user != ""

  match:
    $user by 1d

  outcome:
    $observed_val = count(metadata.id)
    $distinct_files = count_distinct(target.resource.name)

    $historical_avg = max(metrics.workspace_total_download_actions(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.user.userid: $user
    ))
    $historical_stddev = max(metrics.workspace_total_download_actions(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.user.userid: $user
    ))
    $historical_active_days = max(metrics.workspace_total_download_actions(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.user.userid: $user
    ))
    $historical_max = max(metrics.workspace_total_download_actions(
        period: 1d, window: 30d, metric: event_count_sum, agg: max,
        principal.user.userid: $user
    ))
    $historical_sum = max(metrics.workspace_total_download_actions(
        period: 1d, window: 30d, metric: event_count_sum, agg: sum,
        principal.user.userid: $user
    ))
}
