// Stage 1: Inbound Network Flow Count & 30d Historical Baseline
// Identifier swap: this extractor keys on `principal.asset.hostname`. Any ONE field below is valid alone for network_flows_inbound;
//   replace it in the event binding AND in every metrics call, keeping the same variable:
//   - PRINCIPAL_DEVICE (principal.asset.hostname | asset_id | ip | mac | product_object_id)
//   - PRINCIPAL_USER (principal.user.userid | email_addresses | employee_id | product_object_id | windows_sid)
//   ip, mac and email_addresses are repeated fields: one event can count toward several entities.
stage stage1_extract {
    network.received_bytes > 0
    network.received_bytes < 1000000000000000
    $event_type = metadata.event_type
    principal.asset.hostname = $entity
    $entity != ""

  match:
    $entity by 1d

  outcome:
    $observed_val = count(metadata.id)

    $historical_avg = max(metrics.network_flows_inbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: avg,
        principal.asset.hostname: principal.asset.hostname
    ))
    $historical_stddev = max(metrics.network_flows_inbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: stddev,
        principal.asset.hostname: principal.asset.hostname
    ))
    $historical_active_days = max(metrics.network_flows_inbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: num_metric_periods,
        principal.asset.hostname: principal.asset.hostname
    ))
    $historical_max = max(metrics.network_flows_inbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: max,
        principal.asset.hostname: principal.asset.hostname
    ))
    $historical_sum = max(metrics.network_flows_inbound(
        period: 1d, window: 30d, metric: event_count_sum, agg: sum,
        principal.asset.hostname: principal.asset.hostname
    ))
}
